# Auto-detect text files and perform LF normalization
* text=auto

# ==============================================================================
# AAYU PROGRAMMING LANGUAGE - GITHUB LINGUIST CONFIGURATION
# ==============================================================================

# Primary Language: AAYU (.aayu, .ay, .aa, .ayon)
*.aayu linguist-language=AAYU
*.aayu linguist-detectable=true
*.ay linguist-language=AAYU
*.ay linguist-detectable=true
*.aa linguist-language=AAYU
*.aa linguist-detectable=true
*.ayon linguist-language=AAYU
*.ayon linguist-detectable=true
*.ayc linguist-language=AAYU
*.aybc linguist-language=AAYU

# Rust Virtual Machine (VM Execution Runtime Only per AAYU Protocol)
runtime_rs/** linguist-language=Rust

# ==============================================================================
# EXCLUDE LEGACY SCRIPTS, DOCS, AND FRONTEND FROM LANGUAGE STATISTICS
# ==============================================================================
# All Python legacy scripts and prototypes (0% Python on GitHub)
*.py linguist-vendored
intent_engine/** linguist-vendored
brainos/** linguist-vendored
aayu_studio/** linguist-vendored
compiler/** linguist-vendored
compiler_bootstrap/** linguist-vendored
runtime/** linguist-vendored
tools/** linguist-vendored
scripts/** linguist-vendored
tests/** linguist-vendored
examples/** linguist-vendored
.archive/** linguist-vendored

# Frontend website and vscode extension assets
website/** linguist-vendored
vscode-aayu/** linguist-vendored
*.ts linguist-vendored
*.tsx linguist-vendored
*.js linguist-vendored
*.jsx linguist-vendored
*.css linguist-vendored
*.scss linguist-vendored
*.html linguist-vendored

# Shell scripts and config
*.ps1 linguist-vendored
*.sh linguist-vendored
*.bat linguist-vendored
*.cmd linguist-vendored
*.tex linguist-documentation
*.md linguist-documentation
docs/** linguist-documentation
specs/** linguist-documentation
