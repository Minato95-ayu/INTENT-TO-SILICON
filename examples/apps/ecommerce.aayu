# AAYU E-Commerce App

model Product
    id: string
    name: string
    price: number
    image: string
end

state products = []
state cart = []
state total = 0

fn load_products()
    products = [
        {"id": "p1", "name": "Laptop", "price": 999},
        {"id": "p2", "name": "Phone", "price": 699},
        {"id": "p3", "name": "Headphones", "price": 199}
    ]
end

fn add_to_cart(p)
    # Ideally cart.append(p) when list functions are fully available
    cart = cart + [p] 
    total = total + p.price
end

fn checkout()
    total = 0
    cart = []
end

load_products()

Page StorePage
    layout Row
        layout Column
            text "Products"
            for p in products
                layout Row
                    text p.name + " - $" + string(p.price)
                    button "Add to Cart" on_click: add_to_cart(p)
                end
            end
        end
        
        layout Column
            text "Shopping Cart"
            for c in cart
                text c.name
            end
            text "Total: $" + string(total)
            button "Checkout" on_click: checkout()
        end
    end
end
