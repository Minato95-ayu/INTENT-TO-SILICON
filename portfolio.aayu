                            Button "View Architecture & Code →" onClick=open_proj_18 backgroundColor="#1e1b4b" color="#a5b4fc" fontSize="13px" fontWeight="bold" padding="8px 14px" borderRadius="8px" marginTop="6px" border="1px solid #4338ca"
                        end

                        # Project 19
                        Card onClick=open_proj_19 backgroundColor="#111827" borderRadius="14px" padding="24px" border="1px solid #1f2937" flexDirection="column" gap="10px"
                            Row justifyContent="space-between" alignItems="center"
                                Text "AAYU Computer Vision" fontSize="20px" fontWeight="bold" color="#ffffff"
                                Text "VISION" fontSize="11px" fontWeight="bold" color="#a855f7" backgroundColor="#581c87" padding="3px 8px" borderRadius="6px"
                            end
                            Text "Native computer vision package for image tensor decoding, color space transformation, resize matrices, and edge filters." fontSize="14px" color="#9ca3af" lineHeight="1.6"
                            Text "Stack: official_packages/aayu-vision" fontSize="12px" color="#818cf8"
                            Button "View Architecture & Code →" onClick=open_proj_19 backgroundColor="#1e1b4b" color="#a5b4fc" fontSize="13px" fontWeight="bold" padding="8px 14px" borderRadius="8px" marginTop="6px" border="1px solid #4338ca"
                        end

