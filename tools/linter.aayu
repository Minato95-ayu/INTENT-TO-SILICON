# ==============================================================================
# AAYU STATIC CODE LINTER & QUALITY GUARD (tools/linter.aayu)
# 100% Pure Self-Hosted AAYU (.aayu)
# Detects unused variables, dead code, division by zero, and syntax anti-patterns
# Emits Rust/Clang-grade beautiful diagnostics with line markers and suggestions
# ==============================================================================
import "std/fs.aayu"

action is_whitespace(ch)
    if ch == " "
        return 1
    end
    if ch == "\t"
        return 1
    end
    if ch == "\r"
        return 1
    end
    if ch == "\n"
        return 1
    end
    return 0
end

action trim_string(s)
    let l = len(s)
    if l == 0
        return ""
    end
    let start = 0
    while start < l
        if is_whitespace(s[start]) == 1
            start = start + 1
        else
            let finish = l - 1
            while finish >= start
                if is_whitespace(s[finish]) == 1
                    finish = finish - 1
                else
                    let res = ""
                    let k = start
                    while k <= finish
                        res = res + s[k]
                        k = k + 1
                    end
                    return res
                end
            end
            return ""
        end
    end
    return ""
end

action string_contains(haystack, needle)
    let h_len = len(haystack)
    let n_len = len(needle)
    if n_len == 0
        return 1
    end
    if h_len < n_len
        return 0
    end
    let i = 0
    while i <= (h_len - n_len)
        let match_found = 1
        let j = 0
        while j < n_len
            if haystack[i + j] != needle[j]
                match_found = 0
                j = n_len
            else
                j = j + 1
            end
        end
        if match_found == 1
            return 1
        end
        i = i + 1
    end
    return 0
end

action split_lines(content)
    let lines = []
    let cur = ""
    let l = len(content)
    let i = 0
    while i < l
        let ch = content[i]
        if ch == "\n"
            lines = lines + [cur]
            cur = ""
        else
            if ch != "\r"
                cur = cur + ch
            end
        end
        i = i + 1
    end
    if len(cur) > 0
        lines = lines + [cur]
    end
    return lines
end

# Extract variable name from 'let var_name = ...'
action extract_var_name(line)
    let trimmed = trim_string(line)
    let l = len(trimmed)
    if l < 5
        return ""
    end
    if trimmed[0] == "l"
        if trimmed[1] == "e"
            if trimmed[2] == "t"
                if trimmed[3] == " "
                    let name = ""
                    let idx = 4
                    let done = 0
                    while idx < l
                        if done == 0
                            let c = trimmed[idx]
                            if c == " "
                                done = 1
                            else
                                if c == "="
                                    done = 1
                                else
                                    name = name + c
                                    idx = idx + 1
                                end
                            end
                        else
                            idx = l
                        end
                    end
                    return name
                end
            end
        end
    end
    return ""
end

action make_underline(width)
    let u = ""
    let i = 0
    while i < width
        u = u + "^"
        i = i + 1
    end
    return u
end

action main()
    let target = env_get("AAYU_TARGET")
    if target == null
        target = "hello.aayu"
    end
    if len(target) == 0
        target = "hello.aayu"
    end

    print("==================================================")
    print("      AAYU SILICON STATIC CODE LINTER (v1.4.0)   ")
    print("==================================================")
    print("Analyzing target: " + target)
    print("Engine: Pure AAYU Static AST & Pattern Inspector")
    print("--------------------------------------------------")

    let content = read_text(target)
    if content == null
        print("[AAYU Lint Error] Cannot read source file: " + target)
        return
    end

    let lines = split_lines(content)
    let num_lines = len(lines)
    let warnings = 0
    let errors = 0

    # 1. Block Balance Check
    let open_blocks = 0
    let line_idx = 0
    while line_idx < num_lines
        let raw = lines[line_idx]
        let line = trim_string(raw)
        let line_num = line_idx + 1

        # Check block openers
        let is_opener = 0
        if string_contains(line, "action ") == 1
            is_opener = 1
        end
        if string_contains(line, "if ") == 1
            is_opener = 1
        end
        if string_contains(line, "while ") == 1
            is_opener = 1
        end
        if string_contains(line, "model ") == 1
            is_opener = 1
        end
        if string_contains(line, "route ") == 1
            is_opener = 1
        end

        if is_opener == 1
            open_blocks = open_blocks + 1
        end

        if line == "end"
            open_blocks = open_blocks - 1
        end

        # Check: division by zero constant
        if string_contains(line, "/ 0") == 1
            warnings = warnings + 1
            print("warning[W003]: division by zero constant detected")
            print("  --> " + target + ":" + line_num + ":5")
            print("   |")
            print(" " + line_num + " | " + raw)
            print("   |     ^^^^^^ division by zero will produce infinity or trap at runtime")
            print("   = help: ensure denominator is non-zero before dividing")
            print("")
        end

        # Check: deprecated 'var' or 'def'
        if string_contains(line, "var ") == 1
            warnings = warnings + 1
            print("warning[W004]: deprecated keyword 'var' detected")
            print("  --> " + target + ":" + line_num + ":1")
            print("   |")
            print(" " + line_num + " | " + raw)
            print("   | ^^^ canonical AAYU uses 'let' for variable bindings")
            print("   = help: replace 'var' with 'let'")
            print("")
        end

        # Check: Unused variable
        let var_name = extract_var_name(line)
        if len(var_name) > 0
            let used = 0
            let scan_idx = line_idx + 1
            while scan_idx < num_lines
                if string_contains(lines[scan_idx], var_name) == 1
                    used = 1
                    scan_idx = num_lines
                else
                    scan_idx = scan_idx + 1
                end
            end
            if used == 0
                warnings = warnings + 1
                print("warning[W001]: variable '" + var_name + "' is declared but never read")
                print("  --> " + target + ":" + line_num + ":5")
                print("   |")
                print(" " + line_num + " | " + raw)
                let u_width = len(var_name)
                print("   |     " + make_underline(u_width) + " unused variable")
                print("   = help: if intentional, prefix with '_' like '_" + var_name + "' or remove it")
                print("")
            end
        end

        # Check: Dead code after return
        if line == "return"
            if (line_idx + 1) < num_lines
                let next_line = trim_string(lines[line_idx + 1])
                if next_line != "end"
                    if len(next_line) > 0
                        warnings = warnings + 1
                        print("warning[W002]: unreachable code detected after return statement")
                        print("  --> " + target + ":" + (line_num + 1) + ":5")
                        print("   |")
                        print(" " + (line_num + 1) + " | " + lines[line_idx + 1])
                        print("   |     ^^^^^^^^^^^^^^ this statement will never execute")
                        print("   = help: move statements before 'return' or remove unreachable code")
                        print("")
                    end
                end
            end
        end

        line_idx = line_idx + 1
    end

    if open_blocks != 0
        errors = errors + 1
        print("error[E001]: block indentation mismatch (unbalanced 'end' statements)")
        print("  --> " + target)
        print("   = help: verify that all 'action', 'if', 'while', 'model', and 'route' blocks are terminated with 'end'")
        print("")
    end

    print("--------------------------------------------------")
    if errors == 0
        if warnings == 0
            print("✓ [AAYU Linter] Checked " + num_lines + " lines. ZERO warnings, ZERO errors! (Clean Code)")
        else
            print("⚡ [AAYU Linter] Checked " + num_lines + " lines: " + warnings + " warning(s) found.")
        end
    else
        print("✗ [AAYU Linter] Checked " + num_lines + " lines: " + errors + " error(s), " + warnings + " warning(s).")
    end
    print("==================================================")
end

main()
