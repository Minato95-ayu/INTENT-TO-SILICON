app PlaygroundApi

route "/api/v1/compile"
    post
        let req = request.body
        let code = req["code"]
        
        file::write("temp_code.aayu", code)
        
        let py_script = "
import sys, json, uuid, io
from compiler.lexer.lexer import Lexer
from compiler.parser.parser import Parser
from compiler.semantic.analyzer import SemanticAnalyzer
from compiler.ir.pipeline import IRPipeline
from compiler.bytecode.encoder import BytecodeEncoder, Opcode
from runtime.session.manager import SessionManager

def compile_it():
    try:
        with open('temp_code.aayu', 'r') as f:
            code = f.read()
    except Exception as e:
        print(json.dumps({'success': False, 'errors': [str(e)]}))
        return

    errors, tokens_out, bytecode_out, vm_output = [], [], [], ''
    old_stdout = sys.stdout
    sys.stdout = io.StringIO()
    
    try:
        tokens = Lexer(code).tokenize()
        tokens_out = [str(t) for t in tokens]
        ast = Parser(tokens).parse()
        ast = SemanticAnalyzer().analyze(ast)
        lir = IRPipeline().to_lir(IRPipeline().to_mir(IRPipeline().to_hir(ast)))
        prog = BytecodeEncoder().encode(lir)
        
        idx = 0
        while idx < len(prog.bytecode) - 2:
            op = prog.bytecode[idx]
            if op == Opcode.HALT:
                bytecode_out.append('HALT')
                break
            try:
                op_name = next(k for k, v in Opcode.__dict__.items() if v == op and not k.startswith('_'))
            except StopIteration:
                op_name = str(op)
            arg = (prog.bytecode[idx+1] << 8) | prog.bytecode[idx+2]
            bytecode_out.append(f'{op_name} {arg}')
            idx += 3
            
        session = SessionManager(prog).get_or_create_session(str(uuid.uuid4()))
        if '__PAGE_START__' in session.vm.action_addresses:
            session.vm.call_action_by_name('__PAGE_START__')
            vm_output += 'PAGE RENDERED. '
        elif 'main' in session.vm.action_addresses:
            session.vm.call_action_by_name('main')
            
        vm_output += sys.stdout.getvalue()
    except Exception as e:
        errors.append(str(e))
    finally:
        sys.stdout = old_stdout
        
    print(json.dumps({'success': len(errors)==0, 'tokens': tokens_out, 'ast': {'type': 'Program'}, 'bytecode': bytecode_out, 'vm_output': vm_output.strip(), 'errors': errors}))

compile_it()
"
        
        file::write("temp_compile.py", py_script)
        let out = process::exec("python temp_compile.py")
        
        let result = json::parse(out)
        respond(result)
    end
end