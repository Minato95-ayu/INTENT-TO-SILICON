{
  "name": "aayu",
  "displayName": "AAYU",
  "description": "AAYU Programming Language Support for VS Code",
  "version": "1.0.0",
  "publisher": "AyushKaushik",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aayu",
        "aliases": [
          "AAYU",
          "aayu"
        ],
        "extensions": [
          ".aayu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aayu",
        "scopeName": "source.aayu",
        "path": "./syntaxes/aayu.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aayu",
        "path": "./snippets/aayu.code-snippets"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:aayu"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/vscode": "^1.125.0",
    "typescript": "^6.0.3"
  }
}
