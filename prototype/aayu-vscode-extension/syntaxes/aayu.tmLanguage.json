{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AAYU",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.aayu",
          "match": "--.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.aayu",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.aayu",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aayu",
          "match": "\\b(if|else|while|for|each|in|repeat|times|try|catch|end|return)\\b"
        },
        {
          "name": "keyword.declaration.aayu",
          "match": "\\b(use|export|task|entity|record|route|guard)\\b"
        },
        {
          "name": "keyword.other.aayu",
          "match": "\\b(run|show|create|find|update|delete|login|logout|serve|with|and|from|to|on)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.aayu",
          "match": "\\b(number|text|list|map)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.aayu",
          "match": "\\b(is|equal to|greater than|less than|not)\\b"
        }
      ]
    }
  },
  "scopeName": "source.aayu"
}
