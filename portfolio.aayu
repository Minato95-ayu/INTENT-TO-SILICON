app AyushPortfolio

Page Home
    Column width="100vw" height="100vh" overflow="hidden" backgroundColor="#0b0f19"

        Row width="100%" padding="14px 48px" justifyContent="space-between" alignItems="center" borderBottom="1px solid #1f2937" backgroundColor="#0b0f19"
            Text "AYUSH" fontSize="20px" fontWeight="800" color="#ffffff" letterSpacing="3px"
            Row alignItems="center" gap="10px"
                Button "About" onClick=scroll_about backgroundColor="transparent" color="#9ca3af" fontSize="15px" padding="8px 14px"
                Button "Skills" onClick=scroll_skills backgroundColor="transparent" color="#9ca3af" fontSize="15px" padding="8px 14px"
                Button "Projects (23)" onClick=scroll_work backgroundColor="transparent" color="#9ca3af" fontSize="15px" padding="8px 14px"
                Button "Playground" onClick=scroll_playground backgroundColor="transparent" color="#a5b4fc" fontSize="15px" padding="8px 14px"
                Button "Contact" onClick=scroll_contact backgroundColor="#6366f1" color="#ffffff" fontSize="15px" padding="9px 20px" borderRadius="8px"
            end
        end

        Column flex="1" minHeight="0" overflowY="auto"

            # ---------------- HERO SECTION ----------------
            Container flexShrink="0" width="100%" minHeight="520px" padding="60px 48px" alignItems="center" justifyContent="center" backgroundColor="#0b0f19"
                Column alignItems="center" gap="20px" maxWidth="900px"
                    Text "SYSTEMS BUILDER & COMPILER ARCHITECT" fontSize="13px" fontWeight="bold" color="#818cf8" letterSpacing="4px"
                    Heading "Hi, I am Ayush." fontSize="64px" fontWeight="900" color="#ffffff" textAlign="center"
                    Text "I build the infrastructure first, then the products on top of it." fontSize="22px" color="#d1d5db" textAlign="center"
                    Text "Self-taught systems and full-stack engineer from Delhi. Creator of the AAYU programming language, Intent-to-Silicon research, and 23+ production systems." fontSize="16px" color="#9ca3af" textAlign="center" maxWidth="660px"
                    Row gap="14px" marginTop="14px"
                    Button "Explore 23+ Projects" onClick=scroll_work backgroundColor="#6366f1" color="#ffffff" fontSize="15px" padding="14px 28px" borderRadius="10px" fontWeight="bold"
                        Button "GitHub Repo" href="https://github.com/Minato95-ayu/INTENT-TO-SILICON" backgroundColor="#1f2937" color="#ffffff" fontSize="15px" padding="14px 28px" borderRadius="10px"
                        Button "Get in touch" onClick=scroll_contact backgroundColor="#111827" color="#e5e7eb" fontSize="15px" padding="14px 28px" borderRadius="10px" border="1px solid #374151"
                    end
                end
            end

            # ---------------- ABOUT SECTION ----------------
            Container id="about" flexShrink="0" width="100%" minHeight="580px" padding="60px 48px" alignItems="center" justifyContent="center" backgroundColor="#0d1220"
                Column gap="22px" maxWidth="960px"
                    Text "About Me" fontSize="36px" fontWeight="800" color="#ffffff"
                    Text "I am a B.Sc. Mathematics (Hons) student at BRABU (expected 2027) and a self-taught systems developer based in Delhi. I believe in writing the low-level foundations myself: custom bytecode compilers, memory-efficient virtual machines, embedded storage engines, and authentication systems." fontSize="17px" color="#d1d5db" lineHeight="1.8"
                    Text "I author rigorous IEEE-format research papers where every single claim is tagged IMPLEMENTED, PROTOTYPE, or FUTURE WORK for complete scientific honesty. I also run an educational channel breaking down how compilers and computers think for engineers." fontSize="17px" color="#d1d5db" lineHeight="1.8"
                    Row gap="16px" marginTop="12px"
                        Card backgroundColor="#111827" borderRadius="12px" padding="20px 24px" border="1px solid #1f2937" flexDirection="column" gap="6px" flex="1"
                            Text "Location" fontSize="12px" color="#9ca3af"
                            Text "Delhi, India" fontSize="18px" fontWeight="bold" color="#ffffff"
                        end
                        Card backgroundColor="#111827" borderRadius="12px" padding="20px 24px" border="1px solid #1f2937" flexDirection="column" gap="6px" flex="1"
                            Text "Academic Background" fontSize="12px" color="#9ca3af"
                            Text "B.Sc. Mathematics (Hons)" fontSize="18px" fontWeight="bold" color="#ffffff"
                        end
                        Card backgroundColor="#111827" borderRadius="12px" padding="20px 24px" border="1px solid #1f2937" flexDirection="column" gap="6px" flex="1"
                            Text "Core Projects" fontSize="12px" color="#9ca3af"
                            Text "AAYU, I2S, Adumate" fontSize="18px" fontWeight="bold" color="#ffffff"
                        end
                    end
                end
            end

            # ---------------- SKILLS SECTION ----------------
            Container id="skills" flexShrink="0" width="100%" minHeight="660px" padding="60px 48px" alignItems="center" justifyContent="center" backgroundColor="#0b0f19"
                Column gap="26px" width="100%" maxWidth="1040px"
                    Text "Core Competencies" fontSize="36px" fontWeight="800" color="#ffffff"
                    Grid gridTemplateColumns="repeat(auto-fit, minmax(300px, 1fr))" gap="18px" width="100%"
                        Card backgroundColor="#111827" borderRadius="14px" padding="24px" border="1px solid #1f2937" flexDirection="column" gap="8px"
                            Text "Language & Compiler Design" fontSize="18px" fontWeight="bold" color="#22d3ee"
                            Text "5,661-line self-hosted compiler pipeline (Lexer, Parser, AST, Analyzer, Bytecode Emitter) in pure AAYU." fontSize="14px" color="#9ca3af" lineHeight="1.6"
                        end
                        Card backgroundColor="#111827" borderRadius="14px" padding="24px" border="1px solid #1f2937" flexDirection="column" gap="8px"
                            Text "Systems Programming & VM" fontSize="18px" fontWeight="bold" color="#22d3ee"
                            Text "Native Silicon VM and x86_64 JIT in Rust. NanBoxed stack architecture achieving 50ns per opcode." fontSize="14px" color="#9ca3af" lineHeight="1.6"
                        end
                        Card backgroundColor="#111827" borderRadius="14px" padding="24px" border="1px solid #1f2937" flexDirection="column" gap="8px"
                            Text "AI & Multi-Agent Architecture" fontSize="18px" fontWeight="bold" color="#22d3ee"
                            Text "Autonomous agent orchestration, token-efficient RAG embeddings, and multi-provider model rotation." fontSize="14px" color="#9ca3af" lineHeight="1.6"
                        end
                        Card backgroundColor="#111827" borderRadius="14px" padding="24px" border="1px solid #1f2937" flexDirection="column" gap="8px"
                            Text "Databases & Storage Engines" fontSize="18px" fontWeight="bold" color="#22d3ee"
                            Text "Custom SQLite integration, Write-Ahead Log (WAL) mode, query planning, and schema migration engines." fontSize="14px" color="#9ca3af" lineHeight="1.6"
                        end
                        Card backgroundColor="#111827" borderRadius="14px" padding="24px" border="1px solid #1f2937" flexDirection="column" gap="8px"
                            Text "Full-Stack Web Development" fontSize="18px" fontWeight="bold" color="#22d3ee"
                            Text "Declarative SSR widget rendering, low-latency async HTTP sockets, Next.js, and TypeScript architectures." fontSize="14px" color="#9ca3af" lineHeight="1.6"
                        end
                        Card backgroundColor="#111827" borderRadius="14px" padding="24px" border="1px solid #1f2937" flexDirection="column" gap="8px"
                            Text "Scientific Research & Education" fontSize="18px" fontWeight="bold" color="#22d3ee"
                            Text "Author of Intent-to-Silicon IEEE papers, creator of technical shorts for engineers and researchers." fontSize="14px" color="#9ca3af" lineHeight="1.6"
                        end
                    end
                end
            end

            # ---------------- WORK / 22+ PROJECTS SECTION ----------------
