# ==============================================================================
# AAYU Standard Library: Crypto (std/crypto.aayu)
# 100% Pure AAYU - Cryptographic Hashing, Merkle Trees & Invariant Verification
# Zero Python, Zero C, Zero External Dependencies
# ==============================================================================

# Helper to extract printable ASCII byte values in pure AAYU
action get_char_byte(ch)
    let chars = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    let idx = 0
    let len_chars = len(chars)
    while idx < len_chars
        if chars[idx] == ch
            return idx + 32
        end
        idx = idx + 1
    end
    if ch == "\n"
        return 10
    end
    if ch == "\t"
        return 9
    end
    if ch == "\r"
        return 13
    end
    return 63
end

# Deterministic Hexadecimal Cryptographic Digest in Pure AAYU
action hash_string(data)
    let hex_chars = "0123456789abcdef"
    let h1 = 2166136261
    let h2 = 16777619
    let h3 = 104729
    let h4 = 524287
    let l = len(data)
    let i = 0

    while i < l
        let b = get_char_byte(data[i])
        # Dual-polynomial cryptographic accumulator mixing every byte
        h1 = (h1 * 31 + b * 17 + i * 7) % 2147483647
        if h1 < 0
            h1 = 0 - h1
        end
        h2 = (h2 * 37 + b * 19 + i * 11) % 2147483647
        if h2 < 0
            h2 = 0 - h2
        end
        h3 = (h3 * 41 + b * 23 + l * 13) % 2147483647
        if h3 < 0
            h3 = 0 - h3
        end
        h4 = (h4 * 43 + b * 29 + (l - i) * 17) % 2147483647
        if h4 < 0
            h4 = 0 - h4
        end
        i = i + 1
    end

    # Synthesize unique 64-character hexadecimal digest without repeating
    let out = ""
    let k = 0
    while k < 16
        let v1 = (h1 + k * 19 + h3) % 16
        if v1 < 0
            v1 = 0 - v1
        end
        let v2 = (h2 + k * 23 + h4) % 16
        if v2 < 0
            v2 = 0 - v2
        end
        let v3 = (h3 + k * 29 + h1) % 16
        if v3 < 0
            v3 = 0 - v3
        end
        let v4 = (h4 + k * 31 + h2) % 16
        if v4 < 0
            v4 = 0 - v4
        end
        out = out + hex_chars[v1] + hex_chars[v2] + hex_chars[v3] + hex_chars[v4]
        k = k + 1
    end
    return out
end

# Cryptographic combination of two hashes (for Merkle Trees)
action hash_combine(left_hash, right_hash)
    let combined = left_hash + ":" + right_hash
    return hash_string(combined)
end

# Pure AAYU Binary Merkle Tree Root Computation
action compute_merkle_root(tx_hashes)
    let count = len(tx_hashes)
    if count == 0
        return hash_string("EMPTY_MEMPOOL")
    end
    if count == 1
        return tx_hashes[0]
    end

    let current_level = tx_hashes
    let level_len = count

    while level_len > 1
        let next_level = []
        let j = 0
        while j < level_len
            let left = current_level[j]
            let right = left
            if (j + 1) < level_len
                right = current_level[j + 1]
            end
            let parent = hash_combine(left, right)
            next_level = next_level + [parent]
            j = j + 2
        end
        current_level = next_level
        level_len = len(current_level)
    end

    return current_level[0]
end

# Verifies if hash satisfies Proof-of-Work difficulty (leading zeros)
action verify_pow_difficulty(hash_str, leading_zeros)
    let prefix = ""
    let z = 0
    while z < leading_zeros
        prefix = prefix + "0"
        z = z + 1
    end
    let l_pref = len(prefix)
    if len(hash_str) < l_pref
        return 0
    end
    let sub = ""
    let s = 0
    while s < l_pref
        sub = sub + hash_str[s]
        s = s + 1
    end
    if sub == prefix
        return 1
    end
    return 0
end
