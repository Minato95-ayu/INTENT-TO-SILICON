// ==============================================================================
// AAYU Standard Library: UI (std/ui.aayu)
// Declarative Flutter-like Component Tree in Pure AAYU
// Zero npm, Zero JavaScript frameworks, Zero External Dependencies
// ==============================================================================

module UI

// Creates a Text widget node
action Text(content)
    return {"type": "Text", "content": content}
end

// Creates an interactive Button widget node
action Button(label, on_click_action)
    return {"type": "Button", "label": label, "onClick": on_click_action}
end

// Creates a vertical Column layout container
action Column(children)
    return {"type": "Column", "children": children}
end

// Creates a horizontal Row layout container
action Row(children)
    return {"type": "Row", "children": children}
end

// Creates a styled Card container
action Card(title, content)
    return {"type": "Card", "title": title, "content": content}
end

// Converts an AAYU widget tree into zero-dependency clean HTML/CSS
action to_html(node)
    let node_type = node["type"]
    
    if node_type == "Text"
        return "<p class=\"aayu-text\">" + node["content"] + "</p>"
    end
    
    if node_type == "Button"
        return "<button class=\"aayu-btn\" onclick=\"" + node["onClick"] + "()\">" + node["label"] + "</button>"
    end
    
    if node_type == "Column"
        let inner = ""
        let kids = node["children"]
        let i = 0
        let total = len(kids)
        while i < total
            inner = inner + to_html(kids[i])
            i = i + 1
        end
        return "<div class=\"aayu-column\">" + inner + "</div>"
    end
    
    if node_type == "Row"
        let inner = ""
        let kids = node["children"]
        let i = 0
        let total = len(kids)
        while i < total
            inner = inner + to_html(kids[i])
            i = i + 1
        end
        return "<div class=\"aayu-row\">" + inner + "</div>"
    end
    
    if node_type == "Card"
        return "<div class=\"aayu-card\"><h3>" + node["title"] + "</h3><div>" + node["content"] + "</div></div>"
    end
    
    return ""
end

// Top-level render action mapped to native runtime output
action render(tree)
    let html = to_html(tree)
    return html
end

end
