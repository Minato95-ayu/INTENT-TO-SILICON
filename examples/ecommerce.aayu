use http.
use db.
use auth.

entity Product.
    text name.
    text description.
    number price.
    number stock.
end.

entity Order.
    text order_number.
    text order_date.
    text status.
    number total_amount.
end.

entity Category.
    text name.
end.

relation Category one_to_many Product.
relation Order many_to_many Product.

task checkout with req.
    return "Checkout completed".
end.

post "/api/checkout" to checkout.

page Dashboard.
end.
