entity User.
    text name.
    text email.
end.

task update_user with req.
    map user.
    set "Ayush Updated" to "name" in user.
    
    update User where "email" equal to "ayush@gmail.com" with user.
    return "User Updated!".
end.

task delete_user with req.
    delete User where "email" equal to "ayush@gmail.com".
    return "User Deleted!".
end.

route "/update" to update_user.
route "/delete" to delete_user.

serve on 8080.
