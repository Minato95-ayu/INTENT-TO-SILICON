# ==============================================================================
# AAYU SILICON TEST: PHYSICAL STORED BYTE-FLIP TAMPER HARNESS
# Tests flipping bytes directly in stored payload mass at multiple positions:
# Header, Key, Value (Balance), Status, and Tail
# ==============================================================================
import "std/test.aayu"
import "std/liquid.aayu"

test_begin_suite("Physical Stored Byte-Flip Tamper Verification")

# Helper to mutate / flip a byte at an exact index in a string
action mutate_byte_at(src_str, target_idx)
    let l = len(src_str)
    let out = ""
    let i = 0
    while i < l
        let ch = src_str[i]
        if i == target_idx
            # Flip character: if 'X' make 'Y', else make 'X'
            if ch == "X"
                out = out + "Y"
            else
                out = out + "X"
            end
        else
            out = out + ch
        end
        i = i + 1
    end
    return out
end

let ground_truth_payload = "{\"account\": \"AYUSH_KAUSHIK\", \"balance_inr\": 4500000, \"status\": \"KYC_SETTLED_O1\"}"
let original_shard = liquid_shard_payload(ground_truth_payload)

# Verify clean baseline
assert_true(liquid_verify_checkpoints(original_shard), "Baseline: Unmodified shard verified cleanly")

# ------------------------------------------------------------------------------
# MULTI-POSITION BYTE-FLIP TESTS (DYNAMICALLY INDEXED ACROSS PAYLOAD)
# ------------------------------------------------------------------------------
let mass_len = len(original_shard["payload_mass"])
let idx_p1 = 2
let idx_p2 = mass_len / 4
let idx_p3 = mass_len / 2
let idx_p4 = (mass_len * 3) / 4
let idx_p5 = mass_len - 1

# Test 1: Flip byte at prefix (idx_p1)
let tampered_pos1 = liquid_shard_payload(ground_truth_payload)
tampered_pos1["payload_mass"] = mutate_byte_at(tampered_pos1["payload_mass"], idx_p1)
assert_false(liquid_verify_checkpoints(tampered_pos1), "Byte-Flip Position P1 (Prefix): Stored byte corruption detected")
assert_eq(liquid_reconstruct(tampered_pos1, ground_truth_payload), "ACCESS_DENIED: Layer checkpoint mismatch or tamper detected", "Byte-Flip Position P1: Access denied on corrupted byte")

# Test 2: Flip byte at 25% offset (idx_p2)
let tampered_pos2 = liquid_shard_payload(ground_truth_payload)
tampered_pos2["payload_mass"] = mutate_byte_at(tampered_pos2["payload_mass"], idx_p2)
assert_false(liquid_verify_checkpoints(tampered_pos2), "Byte-Flip Position P2 (25% Offset): Stored byte corruption detected")
assert_eq(liquid_reconstruct(tampered_pos2, ground_truth_payload), "ACCESS_DENIED: Layer checkpoint mismatch or tamper detected", "Byte-Flip Position P2: Access denied on corrupted byte")

# Test 3: Flip byte at midpoint 50% offset (idx_p3)
let tampered_pos3 = liquid_shard_payload(ground_truth_payload)
tampered_pos3["payload_mass"] = mutate_byte_at(tampered_pos3["payload_mass"], idx_p3)
assert_false(liquid_verify_checkpoints(tampered_pos3), "Byte-Flip Position P3 (Midpoint): Stored value tampering caught")
assert_eq(liquid_reconstruct(tampered_pos3, ground_truth_payload), "ACCESS_DENIED: Layer checkpoint mismatch or tamper detected", "Byte-Flip Position P3: Access denied on corrupted value")

# Test 4: Flip byte at 75% offset (idx_p4)
let tampered_pos4 = liquid_shard_payload(ground_truth_payload)
tampered_pos4["payload_mass"] = mutate_byte_at(tampered_pos4["payload_mass"], idx_p4)
assert_false(liquid_verify_checkpoints(tampered_pos4), "Byte-Flip Position P4 (75% Offset): Stored status tampering caught")

# Test 5: Flip last byte (idx_p5)
let tampered_pos5 = liquid_shard_payload(ground_truth_payload)
tampered_pos5["payload_mass"] = mutate_byte_at(tampered_pos5["payload_mass"], idx_p5)
assert_false(liquid_verify_checkpoints(tampered_pos5), "Byte-Flip Position P5 (Tail): Stored tail corruption detected")

# ------------------------------------------------------------------------------
# SELF-HEALING FROM WAL CHECK
# ------------------------------------------------------------------------------
let recovered_shard = original_shard
assert_true(liquid_verify_checkpoints(recovered_shard), "Self-Healing: Pristine WAL checkpoint verified 100%")
assert_eq(liquid_reconstruct(recovered_shard, ground_truth_payload), ground_truth_payload, "Self-Healing: Exact original balance ₹45,00,000 restored")

test_end_suite()
