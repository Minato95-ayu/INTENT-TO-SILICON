action render_props(props)
    let html = ""
    let prop_keys = map::keys(props)
    let i = 0
    let loop_len = list::length(prop_keys)
    while i < loop_len
        let k = prop_keys[i]
        let v = props[k]
        if k != "children"
            if k != "type"
                html = html + " " + k + '="' + v + '"'
            end
        end
        i = i + 1
    end
    return html
end

action render_node(node)
    if typeof(node) == "str"
        return node
    end
    
    let type = node["type"]
    let props = node["props"]
    let children = node["children"]
    
    let tag = "div"
    let style = ""
    if type == "Column"
        tag = "div"
        style = " style=\"display: flex; flex-direction: column;\""
    elif type == "Row"
        tag = "div"
        style = " style=\"display: flex; flex-direction: row;\""
    elif type == "button"
        tag = "button"
    elif type == "Button"
        tag = "button"
    elif type == "text"
        tag = "p"
    elif type == "Text"
        tag = "p"
    elif type == "heading"
        tag = "h1"
    elif type == "image"
        tag = "img"
    elif type == "Image"
        tag = "img"
    elif type == "input"
        tag = "input"
    elif type == "Input"
        tag = "input"
    end
    
    let html = "<" + tag + style + render_props(props) + ">"
    
    if type != "img" 
        if type != "image"
            if type != "Image"
                if type != "input"
                    if type != "Input"
                        let i = 0
                        let ch_len = list::length(children)
                        while i < ch_len
                            let child_html = render_node(children[i])
                            html = html + child_html
                            i = i + 1
                        end
                        html = html + "</" + tag + ">"
                    end
                end
            end
        end
    end
    
    return html
end

action render_page(root_node)
    let html = "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n</head>\n<body>\n<div id=\"root\">\n"
    html = html + render_node(root_node)
    html = html + "\n</div>\n<script src=\"/app.js\"></script>\n</body>\n</html>"
    return html
end

let sample_node = {
    "type": "Column",
    "props": {},
    "children": [
        {
            "type": "heading",
            "props": {},
            "children": ["Hello AAYU SSR!"]
        },
        {
            "type": "button",
            "props": {"onClick": "increment"},
            "children": ["Click Me"]
        }
    ]
}

print("SSR Output:")
let result = render_page(sample_node)
print(result)
