# AAYU Auth App

state username = ""
state password = ""
state is_logged_in = false
state error_message = ""

fn login()
    if username == "admin" && password == "password123"
        is_logged_in = true
        error_message = ""
    else
        is_logged_in = false
        error_message = "Invalid credentials."
    end
end

fn logout()
    is_logged_in = false
    username = ""
    password = ""
end

page AuthPage
    layout Column
        if is_logged_in
            text "Welcome back, " + username + "!"
            button "Logout" on_click: logout()
        else
            text "Login to AAYU System"
            if error_message != ""
                text error_message
            end
            input "Username" bind: username
            input "Password" bind: password
            button "Login" on_click: login()
        end
    end
end
