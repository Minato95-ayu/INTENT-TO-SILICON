# 1. BACKEND: AAYU language me JSON API banai
task api_hello.
    let response is {"status": "success", "message": "Backend written purely in AAYU Language!"}.
    let json_str is json::stringify(response).
    return json_str.
end.

# 2. FRONTEND: AAYU language me HTML Web Page banai
task home_page.
    let html is "<!DOCTYPE html><html><head><title>AAYU Full-Stack</title><style>body { font-family: Arial; text-align: center; margin-top: 50px; background: #1e1e1e; color: white; } button { padding: 10px 20px; font-size: 16px; cursor: pointer; background: #3b82f6; color: white; border: none; border-radius: 5px; }</style></head><body><h1>AAYU Language Server</h1><p>This frontend page is served directly by AAYU's built-in HTTP runtime.</p><button onclick='fetchData()'>Call AAYU Backend API</button><p id='result' style='color: #4ade80; margin-top: 20px; font-size: 18px; font-weight: bold;'></p><script>function fetchData() { fetch('/api/hello').then(res => res.json()).then(data => { document.getElementById('result').innerText = '✅ API Response: ' + data.message; }); }</script></body></html>".
    
    return html.
end.

# 3. ROUTING: URL paths ko functions se connect kiya
get "/api/hello" to api_hello.
get "/" to home_page.

# 4. SERVER START: Built-in server start kiya
show("Starting AAYU Full-Stack Server on port 8080...").
serve on 8080.
