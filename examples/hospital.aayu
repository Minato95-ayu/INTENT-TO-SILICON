# AAYU Hospital System Example
use http.
use db.
use auth.
use rbac.

entity Patient.
    text name.
    text dob.
    text blood_group.
    text history.
end.

entity Doctor.
    text name.
    text specialization.
    number experience.
end.

entity Appointment.
    text date.
    text time.
    text status.
    number patient_id.
    number doctor_id.
end.

relation Doctor one_to_many Appointment.
relation Patient one_to_many Appointment.

role Admin.
role DoctorRole.
role Receptionist.

allow Admin create Doctor.
allow Admin delete Doctor.
allow Receptionist create Patient.
allow Receptionist create Appointment.
allow DoctorRole update Appointment.

workflow PatientVisit for Appointment.
    step Scheduled.
    step CheckedIn.
    step InConsultation.
    step Completed.
end.

page HospitalDashboard.
    sidebar.
        text "Overview".
        text "Doctors".
        text "Patients".
        text "Appointments".
    end.
    column.
        heading "Hospital Management System".
        table "Today's Appointments".
        end.
    end.
end.

task handle_dashboard with req.
    return render "HospitalDashboard.html".
end.

get "/dashboard" to handle_dashboard.

serve on 8080.
