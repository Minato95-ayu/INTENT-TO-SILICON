digraph CFG {
  node [shape=box];
  "entry_1" [label="entry_1\nr1 = load_const 10\nr4 = load_const 5\nr2 = cmp_gt r1, r4\nbranch r2, then_2, else_3\n"];
  "entry_1" -> "then_2";
  "entry_1" -> "else_3";
