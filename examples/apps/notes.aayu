# AAYU Notes App
# Demonstrates basic database models, state lists, and UI

model Note
    title: string
    content: string
end

state notes = []
state current_title = ""
state current_content = ""

fn load_notes()
    notes = db_find("Note")
end

fn save_note()
    if current_title != ""
        db_insert("Note", {"title": current_title, "content": current_content})
        current_title = ""
        current_content = ""
        load_notes()
    end
end

fn delete_note(id)
    db_delete("Note", id)
    load_notes()
end

# Initial load
load_notes()

Page NotesPage
    layout Column
        text "AAYU Notes App"
        
        layout Row
            input "Title" bind: current_title
            input "Content" bind: current_content
            button "Save Note" on_click: save_note()
        end
        
        layout Column
            for note in notes
                layout Row
                    text note.title + ": " + note.content
                    button "Delete" on_click: delete_note(note.id)
                end
            end
        end
    end
end
