                        Card onClick=open_proj_20 backgroundColor="#111827" borderRadius="14px" padding="24px" border="1px solid #1f2937" flexDirection="column" gap="10px"
                            Row justifyContent="space-between" alignItems="center"
                                Text "VS Code Extension" fontSize="20px" fontWeight="bold" color="#ffffff"
                                Text "DEV TOOLS" fontSize="11px" fontWeight="bold" color="#10b981" backgroundColor="#064e3b" padding="3px 8px" borderRadius="6px"
                            end
                            Text "Official VS Code IDE extension (vscode-aayu) with custom syntax highlighting grammars, snippet engines, and LSP autocomplete." fontSize="14px" color="#9ca3af" lineHeight="1.6"
                            Text "Status: Packaged .vsix extension" fontSize="12px" color="#818cf8"
                            Button "View Architecture & Code →" onClick=open_proj_20 backgroundColor="#1e1b4b" color="#a5b4fc" fontSize="13px" fontWeight="bold" padding="8px 14px" borderRadius="8px" marginTop="6px" border="1px solid #4338ca"
                        end

                        # Project 21
                        Card onClick=open_proj_21 backgroundColor="#111827" borderRadius="14px" padding="24px" border="1px solid #1f2937" flexDirection="column" gap="10px"
                            Row justifyContent="space-between" alignItems="center"
                                Text "Zero to Research AI" fontSize="20px" fontWeight="bold" color="#ffffff"
