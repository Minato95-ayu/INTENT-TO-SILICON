# 1. Computer Science: Fibonacci Sequence (Iterative Stress Test)
action fibonacci(n)
    let a = 0
    let b = 1
    let i = 0
    
    while i < n
        let temp = a + b
        a = b
        b = temp
        i = i + 1
    end
    
    return a
end

# 2. Data Structures: Array Linear Search
action search(arr, target)
    let length = 5
    let i = 0
    let found = 0
    
    while i < length
        let val = arr[i]
        if val == target
            found = 1
        end
        i = i + 1
    end
    
    return found
end

# 3. Finance & Business Logic: Discount / Tax Calculation (Integer Math)
action calc_discount(price, discount_percent)
    let temp = price * discount_percent
    let discount = temp / 100
    let final_price = price - discount
    return final_price
end

action main()
    print("--- 1. CS Algorithm: Fibonacci(10) ---")
    let f = fibonacci(10)
    print("Result (Should be 55): " + f)
    
    print("--- 2. Data Structures: Array Search ---")
    let nums = [10, 50, 30, 70, 90]
    let s = search(nums, 70)
    print("Found 70? (1 = Yes, 0 = No): " + s)
    
    print("--- 3. Finance: Discount Engine ---")
    let p = calc_discount(1000, 20)
    print("Price 1000 with 20% discount: " + p)
    
    print("ALL WORLD-CLASS ALGORITHMS PASSED!")
    return 0
end

run main()
