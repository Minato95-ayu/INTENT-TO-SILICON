                            Row justifyContent="space-between" alignItems="center"
                                Text "Core Systems Foundations" fontSize="20px" fontWeight="bold" color="#ffffff"
                                Text "SYSTEMS" fontSize="11px" fontWeight="bold" color="#3b82f6" backgroundColor="#1e3a8a" padding="3px 8px" borderRadius="6px"
                            end
