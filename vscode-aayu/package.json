{
  "name": "aayu",
  "displayName": "AAYU",
  "description": "AAYU syntax highlighting and run command for the Rust VM",
  "version": "1.3.0",
  "publisher": "AyushGhritKaushik",
  "author": "Ayush Ghrit Kaushik <https://github.com/Minato95-ayu>",
  "engines": {
    "vscode": "^1.125.0"
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AAYU-Lang/vscode-aayu.git"
  },
  "bugs": {
    "url": "https://github.com/Minato95-ayu/INTENT-TO-SILICON/issues"
  },
  "homepage": "https://github.com/Minato95-ayu/INTENT-TO-SILICON#readme",
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:aayu.runFile",
    "onCommand:aayu.runTest",
    "onCommand:aayu.formatFile",
    "onCommand:aayu.disasmFile",
    "onCommand:aayu.packFile",
    "onCommand:aayu.benchFile"
  ],
  "contributes": {
    "commands": [
      { "command": "aayu.runFile", "title": "AAYU: Run Current File" },
      { "command": "aayu.runTest", "title": "AAYU: Run Test Suite (aayu test)" },
      { "command": "aayu.formatFile", "title": "AAYU: Format Document (aayu fmt)" },
      { "command": "aayu.disasmFile", "title": "AAYU: Disassemble Bytecode (aayu disasm)" },
      { "command": "aayu.packFile", "title": "AAYU: Pack Standalone Package (aayu pack)" },
      { "command": "aayu.benchFile", "title": "AAYU: Run Silicon Benchmark (aayu bench)" }
    ],
    "languages": [
      {
        "id": "aayu",
        "aliases": [
          "AAYU",
          "aayu"
        ],
        "extensions": [
          ".aayu",
          ".ay",
          ".aa",
          ".ayon",
          ".ayc",
          ".aybc"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/aayu-light.png",
          "dark": "./icons/aayu-dark.png"
        }
      }
    ],
    "iconThemes": [
      {
        "id": "aayu-file-icons",
        "label": "AAYU File Icons",
        "path": "./icons/aayu-icon-theme.json"
      }
    ],
    "grammars": [
      {
        "language": "aayu",
        "scopeName": "source.aayu",
        "path": "./syntaxes/aayu.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aayu",
        "path": "./snippets/aayu.code-snippets"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "AAYU Configuration",
      "properties": {
        "aayu.executablePath": {
          "type": "string",
          "default": "aayu-vm",
          "description": "Path or command name for the AAYU Rust VM executable."
        },
        "aayu.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to aayuc when it is not beside the VM or on PATH."
        }
      }
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2"
  }
}
