# Full-Stack AAYU Demonstration


model User {
    name: String
    email: String
}

state title = "Welcome to AAYU Full Stack!"

Page Home
    Column
        Heading title
        
        Form id="userForm"
            Input placeholder="Enter Username" name="username"
            Input placeholder="Enter Email" name="email"
            Button "Create User" onClick="createUser"
        end
    end
end

action createUser
    print("User created via Action!")
end

route "/api/users"
    get
        return "{'status': 'ok', 'users': []}"
    end
end

