# ==============================================================================
# AAYU Standard Library: Server (std/server.aayu)
# 100% Pure AAYU - Native Web Server & Response Formatting Helpers
# ==============================================================================

action format_response(status, content_type, body)
    let res = "HTTP/1.1 " + status + " OK\r\n"
    res = res + "Content-Type: " + content_type + "\r\n"
    res = res + "Content-Length: " + len(body) + "\r\n"
    res = res + "Connection: close\r\n\r\n"
    res = res + body
    return res
end

action json_response(status, data_str)
    return format_response(status, "application/json", data_str)
end

action html_response(status, html_str)
    return format_response(status, "text/html; charset=utf-8", html_str)
end
