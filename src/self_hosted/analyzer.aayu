
# AAYU Self-Hosted Semantic Analyzer

# Scope stacks using parallel arrays because AAYU dicts are immutable
let scopes_keys = [[]]
let scopes_vals = [[]]

action push_scope()
    scopes_keys = scopes_keys + [[]]
    scopes_vals = scopes_vals + [[]]
    return 0
end

action pop_scope()
    let ps_len = len(scopes_keys)
    let ps_new_k = []
    let ps_new_v = []
    let ps_i = 0
    while ps_i < ps_len - 1
        ps_new_k = ps_new_k + [scopes_keys[ps_i]]
        ps_new_v = ps_new_v + [scopes_vals[ps_i]]
        ps_i = ps_i + 1
    end
    scopes_keys = ps_new_k
    scopes_vals = ps_new_v
    return 0
end

action update_scope_array(arr, index, val)
    let ua_res = []
    let ua_i = 0
    let ua_l = len(arr)
    while ua_i < ua_l
        if ua_i == index
            ua_res = ua_res + [val]
        else
            ua_res = ua_res + [arr[ua_i]]
        end
        ua_i = ua_i + 1
    end
    return ua_res
end

action define_symbol(name, sym_type)
    let ds_top_idx = len(scopes_keys) - 1
    
    let ds_keys = scopes_keys[ds_top_idx]
    let ds_vals = scopes_vals[ds_top_idx]
    
    # check for duplicates in current scope
    let ds_i = 0
    let ds_l = len(ds_keys)
    while ds_i < ds_l
        if ds_keys[ds_i] == name
            print("[Semantic Error] Duplicate declaration of: ")
            print(name)
            return 0
        end
        ds_i = ds_i + 1
    end
    
    ds_keys = ds_keys + [name]
    ds_vals = ds_vals + [sym_type]
    
    scopes_keys = update_scope_array(scopes_keys, ds_top_idx, ds_keys)
    scopes_vals = update_scope_array(scopes_vals, ds_top_idx, ds_vals)
    return 0
end

action resolve_symbol(name)
    let rs_i = len(scopes_keys) - 1
    while rs_i >= 0
        let rs_keys = scopes_keys[rs_i]
        let rs_vals = scopes_vals[rs_i]
        let rs_j = 0
        let rs_l = len(rs_keys)
        while rs_j < rs_l
            if rs_keys[rs_j] == name
                return rs_vals[rs_j]
            end
            rs_j = rs_j + 1
        end
        rs_i = rs_i - 1
    end
    return ""
end

action analyze_expression(expr)
    let ae_type = expr["type"]
    let ae_sym = ""
    let ae_args = []
    let ae_sem_args = []
    let ae_i = 0
    let ae_l = 0
    
    if ae_type == "Number"
        return { "type": "SemanticLiteralNode", "value": expr["value"], "dtype": "Number" }
    end
    if ae_type == "String"
        return { "type": "SemanticLiteralNode", "value": expr["value"], "dtype": "String" }
    end
    if ae_type == "Literal"
        return { "type": "SemanticLiteralNode", "value": expr["value"], "dtype": "Unknown" }
    end
    if ae_type == "Identifier"
        ae_sym = resolve_symbol(expr["name"])
        if ae_sym == ""
            print("[Semantic Error] Undeclared identifier: ")
            print(expr["name"])
            return null
        end
        return { "type": "SemanticIdentifierNode", "name": expr["name"] }
    end
    if ae_type == "BinaryOp"
        let ae_left = analyze_expression(expr["left"])
        let ae_right = analyze_expression(expr["right"])
        return { "type": "SemanticBinaryOpNode", "operator": expr["operator"], "left": ae_left, "right": ae_right }
    end
    if ae_type == "ActionCall"
        ae_sym = resolve_symbol(expr["name"])
        if ae_sym == ""
            print("[Semantic Error] Undeclared function: ")
            print(expr["name"])
        end
        
        ae_args = expr["args"]
        ae_sem_args = []
        while len(ae_sem_args) < len(ae_args)
            ae_sem_args = ae_sem_args + [analyze_expression(ae_args[len(ae_sem_args)])]
        end
        return { "type": "SemanticActionCallNode", "name": expr["name"], "args": ae_sem_args }
    end
    if ae_type == "Array"
        ae_args = expr["elements"]
        ae_sem_args = []
        while len(ae_sem_args) < len(ae_args)
            ae_sem_args = ae_sem_args + [analyze_expression(ae_args[len(ae_sem_args)])]
        end
        return { "type": "SemanticArrayNode", "elements": ae_sem_args }
    end
    return expr
end

action analyze_statement(stmt)
    let as_type = stmt["type"]
    let as_sym = ""
    let as_val = {}
    let as_i = 0
    let as_l = 0
    let as_target = {}
    
    if as_type == "LetDeclaration"
        define_symbol(stmt["name"], "local")
        as_val = analyze_expression(stmt["value"])
        return { "type": "SemanticLetDeclNode", "name": stmt["name"], "value": as_val }
    end
    if as_type == "Assignment"
        as_target = stmt["target"]
        if as_target["type"] == "Identifier"
            as_sym = resolve_symbol(as_target["name"])
            if as_sym == ""
                print("[Semantic Error] Assignment to undeclared identifier: ")
                print(as_target["name"])
            end
        end
        as_val = analyze_expression(stmt["value"])
        return { "type": "SemanticAssignmentNode", "target": as_target, "value": as_val }
    end
    if as_type == "If"
        let as_cond = analyze_expression(stmt["condition"])
        
        push_scope()
        let as_then = []
        let as_tb = stmt["then_branch"]
        while len(as_then) < len(as_tb)
            as_then = as_then + [analyze_statement(as_tb[len(as_then)])]
        end
        pop_scope()
        
        push_scope()
        let as_else = []
        let as_eb = stmt["else_branch"]
        while len(as_else) < len(as_eb)
            as_else = as_else + [analyze_statement(as_eb[len(as_else)])]
        end
        pop_scope()
        
        return { "type": "SemanticIfNode", "condition": as_cond, "then_branch": as_then, "else_branch": as_else }
    end
    if as_type == "Return"
        if stmt["value"] != ""
            return { "type": "SemanticReturnNode", "value": analyze_expression(stmt["value"]) }
        else
            return { "type": "SemanticReturnNode", "value": "" }
        end
    end
    if as_type == "ExpressionStatement"
        return { "type": "SemanticExpressionStatementNode", "expression": analyze_expression(stmt["expression"]) }
    end
    if as_type == "ActionDeclaration"
        define_symbol(stmt["name"], "function")
        
        push_scope()
        let as_args = stmt["args"]
        as_i = 0
        as_l = len(as_args)
        while as_i < as_l
            define_symbol(as_args[as_i], "local")
            as_i = as_i + 1
        end
        
        let as_body = []
        let as_stmts = stmt["statements"]
        while len(as_body) < len(as_stmts)
            as_body = as_body + [analyze_statement(as_stmts[len(as_body)])]
        end
        pop_scope()
        
        return { "type": "SemanticActionDeclarationNode", "name": stmt["name"], "args": as_args, "statements": as_body }
    end
    return stmt
end

action analyze(ast)
    define_symbol("print", "function")
    define_symbol("len", "function")
    
    if ast["type"] == "Program"
        let a_stmts = ast["statements"]
        let a_sem_stmts = []
        let a_i = 0
        let a_l = len(a_stmts)
        while a_i < a_l
            a_sem_stmts = a_sem_stmts + [analyze_statement(a_stmts[a_i])]
            a_i = a_i + 1
        end
        return { "type": "SemanticProgramNode", "statements": a_sem_stmts }
    end
    return {}
end

let sample_ast = { 
    "type": "Program", 
    "statements": [
        { 
            "type": "ActionDeclaration", 
            "name": "factorial", 
            "args": ["n"], 
            "statements": [
                {
                    "type": "If",
                    "condition": {
                        "type": "BinaryOp",
                        "operator": "<=",
                        "left": { "type": "Identifier", "name": "n" },
                        "right": { "type": "Number", "value": 1 }
                    },
                    "then_branch": [
                        {
                            "type": "Return",
                            "value": { "type": "Number", "value": 1 }
                        }
                    ],
                    "else_branch": [
                        {
                            "type": "Return",
                            "value": {
                                "type": "BinaryOp",
                                "operator": "*",
                                "left": { "type": "Identifier", "name": "n" },
                                "right": {
                                    "type": "ActionCall",
                                    "name": "factorial",
                                    "args": [
                                        {
                                            "type": "BinaryOp",
                                            "operator": "-",
                                            "left": { "type": "Identifier", "name": "n" },
                                            "right": { "type": "Number", "value": 1 }
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "ExpressionStatement",
                    "expression": {
                        "type": "ActionCall",
                        "name": "UNDECLARED_FUNC",
                        "args": []
                    }
                },
                {
                    "type": "LetDeclaration",
                    "name": "x",
                    "value": { "type": "Number", "value": 10 }
                },
                {
                    "type": "LetDeclaration",
                    "name": "x",
                    "value": { "type": "Number", "value": 20 }
                }
            ] 
        }
    ] 
}

let sem_ast = analyze(sample_ast)

print("Semantic Analysis Complete!")
print("Input AST statements length: ")
print(len(sample_ast["statements"]))
print("Output Semantic AST statements length: ")
print(len(sem_ast["statements"]))
