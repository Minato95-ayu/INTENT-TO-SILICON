app ChatServer

route "/ws/chat"
    websocket
        action on_connect(client)
            print("Client connected: " + client.id)
            server.broadcast({"type": "system", "message": "User joined: " + client.id})
        end
        
        action on_message(client, msg)
            let data = json::parse(msg)
            server.broadcast({
                "type": "message",
                "sender": client.id,
                "text": data.text
            })
        end
        
        action on_disconnect(client)
            server.broadcast({"type": "system", "message": "User left: " + client.id})
        end
    end
end

Page ChatUI
    state messages = []
    state input_text = ""
    
    action on_receive(msg)
        let data = json::parse(msg)
        messages.push(data)
    end
    
    action send
        websocket::send("/ws/chat", {"text": input_text})
        input_text = ""
    end
    
    Lifecycle
        onMount: action() websocket::connect("/ws/chat", on_receive) end
    end
    
    Column
        Text("AAYU Chat", size: 24, weight: "bold")
        
        Container(height: 400, scroll: true)
            for msg in messages
                if msg.type == "system"
                    Text(msg.message, color: "gray")
                else
                    Text(msg.sender + ": " + msg.text)
                end
            end
        end
        
        Row
            Input(value: input_text, onChange: action(v) input_text = v end)
            Button("Send", onClick: send)
        end
    end
end

action main
    print("Starting Chat Server on port 8003...")
    server.start(8003)
end

run main
