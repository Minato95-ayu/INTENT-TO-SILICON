# ============================================================================
# AAYU COMPILER IN AAYU (Self-Hosting Phase 3)
# File: lexer.aayu
# Purpose: A pure AAYU implementation of the AAYU Lexical Analyzer
# ============================================================================

app AAYULexer

# 1. Data Model for a Token
model Token {
    type: String
    value: String
    line: Int
    column: Int
}

# 2. Helper Functions (using our new string primitives!)
action is_alpha(char)
    let code = string::char_code(char, 0)
    # A-Z is 65-90
    if code >= 65
        if code <= 90
            return 1
        end
    end
    # a-z is 97-122
    if code >= 97
        if code <= 122
            return 1
        end
    end
    # _ is 95
    if code == 95
        return 1
    end
    return 0
end

action is_digit(char)
    let code = string::char_code(char, 0)
    # 0-9 is 48-57
    if code >= 48
        if code <= 57
            return 1
        end
    end
    return 0
end

# 3. The Core Lexer Action
action lex(source)
    let tokens = []
    let i = 0
    # Currently relying on a fixed length or finding a terminator since string::length is pending
    # We will simulate the main loop:
    
    # In actual implementation: while i < string::length(source)
    
    let current_char = string::char_at(source, i)
    
    if is_alpha(current_char) == 1
        # Lex Identifier or Keyword
        let token = Token.new("IDENTIFIER", current_char, 1, 1)
        list::push(tokens, token)
    end
    
    return tokens
end

action main
    print("========================================")
    print("AAYU NATIVE LEXER (BOOTSTRAPPING)")
    print("========================================")
    
    let source = "let x = 100;"
    print("Source:")
    print(source)
    
    let tokens = lex(source)
    
    print("Tokens Generated by AAYU natively:")
    print(tokens)
end

run main
