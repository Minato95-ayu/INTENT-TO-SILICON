app CollectionsProof

action main
    # STRING TESTS
    let s = "AAYU Self Hosting"
    let parts = string::split(s, " ")
    let u = string::upper(s)
    let length = string::length(s)
    
    print(parts)
    print(u)
    print(length)
    
    # ARRAY TESTS
    let arr = [1, 2, 3]
    list::push(arr, 4)
    print(arr)
    
    let first = list::get(arr, 0)
    print("First element:")
    print(first)
    
    let arr_len = list::length(arr)
    print("Array length:")
    print(arr_len)
end

run main
