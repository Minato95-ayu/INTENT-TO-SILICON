# AAYU IDE (Integrated Development Environment)

state current_file = "main.aayu"
state file_content = "page Home\n  text 'Hello AAYU'\nend"
state console_output = "Compiler Ready."

fn compile_code()
    console_output = "Compiling " + current_file + "...\nSuccess!"
end

fn run_code()
    console_output = "Running...\nHello AAYU\nProcess exited with code 0."
end

Page IDE
    layout Column
        layout Row
            text "AAYU Studio"
            button "Compile" on_click: compile_code()
            button "Run" on_click: run_code()
        end
        
        layout Row
            # File Explorer
            layout Column
                text "EXPLORER"
                text "main.aayu"
                text "utils.aayu"
            end
            
            # Editor
            layout Column
                text "EDITOR: " + current_file
                input "Code" bind: file_content
            end
        end
        
        # Terminal / Console
        layout Column
            text "TERMINAL"
            text console_output
        end
    end
end
