app EnterprisePortal

# ==============================================================================
# AAYU ENTERPRISE FLAGSHIP FULL-STACK APPLICATION
# Architecture: Intent-to-Silicon Single-File System
# Engine: AayuDB RAM-First In-Memory + SSD WAL Persistence
# Integrations: Kafka Event Mesh, REST Microservices, Zero-Tracking GDPR Compliance
# ==============================================================================

# 1. DATABASE MODELS (AayuDB Native In-Memory Schema)
model User
    id Int
    username String
    email String
    role String
    password_hash String
    created_at String
end

model AuditEvent
    id Int
    topic String
    payload String
    latency String
end

# 2. DECLARATIVE REST API ROUTES
route "/api/register"
    post
        respond({
            "status": "success",
            "message": "User registered into AayuDB with SHA-256 hash",
            "storage": "In-Memory WAL Synced",
            "latency": "< 1.2ms"
        })
    end
end

route "/api/login"
    post
        respond({
            "status": "success",
            "token": "aayu_jwt_sec_89dfa38210e",
            "message": "Authentication successful"
        })
    end
end

route "/api/users"
    get
        respond({
            "status": "success",
            "engine": "AayuDB",
            "users": []
        })
    end
end

route "/api/events"
    post
        respond({
            "status": "acknowledged",
            "broker": "AAYU Event Streamer (Kafka Compatible)",
            "partition": 0,
            "latency": "< 0.5ms"
        })
    end
end

route "/api/metrics"
    get
        respond({
            "engine": "AAYU Silicon Runtime v1.4.0",
            "ram_mb": 2.38,
            "latency_ms": 0.82,
            "tokens_saved_pct": 78.4,
            "architecture": "Intent-to-Silicon",
            "zero_dependencies": true
        })
    end
end

route "/api/compliance/audit"
    get
        respond({
            "status": "COMPLIANT",
            "gdpr_compliant": true,
            "data_minimization": "enforced",
            "cookie_less": true,
            "wcag_accessibility": "AAA",
            "zero_dark_patterns": true
        })
    end
end

# 3. FULL-STACK SINGLE-PAGE APPLICATION UI
route "/"
    get
        respond("""<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AAYU Enterprise Portal — Silicon Full-Stack</title>
    <style>
        :root {
            --bg: #090d16;
            --surface: #111827;
            --surface-hover: #1f2937;
            --border: #1f2937;
            --primary: #38bdf8;
            --primary-glow: rgba(56, 189, 248, 0.25);
            --emerald: #10b981;
            --purple: #a855f7;
            --rose: #f43f5e;
            --amber: #f59e0b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            line-height: 1.5;
            min-height: 100vh;
        }
        /* Top Navigation */
        header {
            background: rgba(17, 24, 39, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 50;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: #fff;
        }
        .brand-badge {
            width: 32px;
            height: 32px;
            background: linear-gradient(135deg, #2563eb, #7c3aed);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 16px;
        }
        .brand-title {
            font-weight: 700;
            font-size: 17px;
            letter-spacing: -0.02em;
        }
        .status-pill {
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #34d399;
            padding: 4px 12px;
            border-radius: 9999px;
            font-size: 12px;
            font-weight: 600;
        }
        .status-dot {
            width: 8px;
            height: 8px;
            background: #10b981;
            border-radius: 50%;
            box-shadow: 0 0 8px #10b981;
            animation: pulse 2s infinite;
        }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
        /* Main Layout */
        main {
            max-width: 1200px;
            margin: 0 auto;
            padding: 24px 16px 60px;
        }
        /* Tab Navigation */
        .tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            border-bottom: 1px solid var(--border);
            margin-bottom: 24px;
            padding-bottom: 12px;
        }
        .tab-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }
        .tab-btn:hover {
            color: #fff;
            background: var(--surface-hover);
        }
        .tab-btn.active {
            color: #fff;
            background: #2563eb;
            box-shadow: 0 0 15px rgba(37, 99, 235, 0.35);
        }
        /* Content Sections */
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .grid-2 {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 20px;
            margin-bottom: 24px;
        }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 20px;
        }
        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }
        .card-title {
            font-size: 16px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        /* Form Inputs */
        .form-group { margin-bottom: 14px; }
        label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        input, select, textarea {
            width: 100%;
            background: #030712;
            border: 1px solid #374151;
            color: #fff;
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            transition: border 0.2s;
        }
        input:focus, select:focus, textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 2px var(--primary-glow);
        }
        .btn-primary {
            width: 100%;
            background: linear-gradient(135deg, #0284c7, #2563eb);
            color: #fff;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-primary:hover {
            filter: brightness(1.15);
            box-shadow: 0 0 16px rgba(14, 165, 233, 0.4);
        }
        /* Tables */
        .table-responsive {
            overflow-x: auto;
            border-radius: 10px;
            border: 1px solid var(--border);
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
            text-align: left;
        }
        th {
            background: #0f172a;
            color: var(--text-muted);
            padding: 12px 14px;
            font-weight: 600;
            border-bottom: 1px solid var(--border);
        }
        td {
            padding: 12px 14px;
            border-bottom: 1px solid #1f2937;
        }
        tr:hover { background: rgba(255, 255, 255, 0.02); }
        .badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 700;
        }
        .badge-admin { background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); }
        .badge-engineer { background: rgba(14, 165, 233, 0.15); color: #38bdf8; border: 1px solid rgba(14, 165, 233, 0.3); }
        .badge-cto { background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3); }
        .hash-mono {
            font-family: monospace;
            font-size: 11px;
            color: #64748b;
            max-width: 140px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 16px;
            display: none;
        }
        .alert-success { background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399; }
        /* Telemetry Cards */
        .metric-val {
            font-size: 32px;
            font-weight: 800;
            color: #fff;
            margin: 4px 0;
            font-family: monospace;
        }
        .metric-sub { font-size: 12px; color: var(--text-muted); }
        /* Checklist */
        .check-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 10px 0;
            border-bottom: 1px solid #1f2937;
            font-size: 13px;
        }
        .check-icon { color: #10b981; font-weight: bold; }
    </style>
</head>
<body>
    <header>
        <a href="/" class="brand">
            <div class="brand-badge">A</div>
            <div>
                <div class="brand-title">AAYU Silicon Enterprise Portal</div>
                <div style="font-size: 10px; color: #64748b;">Single-File Full-Stack • Intent-to-Silicon</div>
            </div>
        </a>
        <div style="display:flex; align-items:center; gap:12px;">
            <a href="https://github.com/Minato95-ayu/INTENT-TO-SILICON" target="_blank" style="text-decoration:none; display:inline-flex; align-items:center; gap:8px; background:linear-gradient(135deg, #1e293b, #0f172a); border:1px solid #38bdf8; color:#fff; padding:7px 14px; border-radius:10px; font-weight:700; font-size:12px; box-shadow:0 0 14px rgba(56,189,248,0.2); transition:all 0.2s ease;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                <span>GitHub Source</span>
                <span style="background:#0284c7; padding:2px 6px; border-radius:10px; font-size:10px; color:#fff;">⭐ 100% Pure AAYU</span>
            </a>
            <div class="status-pill">
                <div class="status-dot"></div>
                <span id="headerUptime">LIVE · 2.38 MB RAM · 0.8ms</span>
            </div>
        </div>
    </header>

    <main>
        <nav class="tabs">
            <button class="tab-btn active" onclick="switchTab('auth', this)">🔐 User Auth & DB Demo</button>
            <button class="tab-btn" onclick="switchTab('stdlib', this)">🧪 Standard Libraries Suite</button>
            <button class="tab-btn" onclick="switchTab('data', this)">📊 Data Engineering Hub</button>
            <button class="tab-btn" onclick="switchTab('telemetry', this)">⚡ Silicon Telemetry</button>
            <button class="tab-btn" onclick="switchTab('kafka', this)">🌐 Kafka & Microservices</button>
            <button class="tab-btn" onclick="switchTab('compliance', this)">⚖️ Vibe-Coder Compliance</button>
        </nav>

        <!-- TAB 1: AUTH & REGISTRATION -->
        <div id="tab-auth" class="tab-content active">
            <div id="authAlert" class="alert alert-success"></div>

            <!-- ACTIVE LOGGED-IN USER PROFILE DASHBOARD -->
            <div id="userProfileCard" class="card" style="margin-bottom:24px; border:2px solid #38bdf8; background:linear-gradient(135deg, rgba(56, 189, 248, 0.06), rgba(17, 24, 39, 0.95)); box-shadow:0 0 25px rgba(56, 189, 248, 0.15);">
                <div class="card-header" style="border-bottom:1px solid #1e293b; padding-bottom:12px; margin-bottom:16px;">
                    <div class="card-title" style="color:#38bdf8; font-size:17px;">
                        <span>👤</span> Active User Profile & Identity Dashboard
                    </div>
                    <div style="display:flex; align-items:center; gap:10px;">
                        <span class="badge badge-engineer" id="profileSessionBadge">ACTIVE JWT SESSION</span>
                        <div style="display:flex; gap:6px;">
                            <button onclick="quickSwitchUser('ayush')" style="background:#0284c7; color:#fff; border:none; padding:4px 8px; border-radius:4px; font-size:11px; cursor:pointer;" title="Switch to Ayush">Switch: Ayush</button>
                            <button onclick="quickSwitchUser('richa_bhadani')" style="background:#7c3aed; color:#fff; border:none; padding:4px 8px; border-radius:4px; font-size:11px; cursor:pointer;" title="Switch to Richa">Switch: Richa</button>
                        </div>
                    </div>
                </div>

                <div style="display:grid; grid-template-columns: 140px 1fr; gap:20px; align-items:start;">
                    <!-- Left: Vector Contour DP -->
                    <div style="display:flex; flex-direction:column; align-items:center; background:#030712; padding:16px 12px; border-radius:12px; border:1px solid #1e293b;">
                        <div id="profileAvatarViewport" style="width:105px; height:105px; display:flex; align-items:center; justify-content:center; overflow:hidden; border-radius:50%; border:2px solid #38bdf8; background:#0b1329;">
                            <!-- Dynamic SVG -->
                        </div>
                        <div style="font-size:11px; color:#10b981; font-weight:bold; margin-top:8px;">✓ Vector Contour DP</div>
                        <div style="font-size:10px; color:#64748b;">4.2 KB (No Pixelation)</div>
                        <button onclick="toggleEditProfile()" style="margin-top:10px; width:100%; background:#1e293b; color:#38bdf8; border:1px solid #38bdf8; padding:6px; border-radius:6px; font-size:11px; cursor:pointer; font-weight:bold;">✏️ Edit Profile</button>
                    </div>

                    <!-- Right: Identity Details & Actions -->
                    <div>
                        <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:12px;">
                            <div>
                                <h2 id="profileDisplayName" style="font-size:22px; font-weight:800; color:#fff; margin:0;">Ayush Kaushik</h2>
                                <div id="profileHandle" style="font-size:13px; color:#38bdf8; font-family:monospace;">@ayush</div>
                            </div>
                            <div id="profileRoleBadge"><span class="badge badge-admin" style="font-size:12px;">Lead Data Engineer & Architect</span></div>
                        </div>

                        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(180px, 1fr)); gap:10px; margin-bottom:12px; font-size:12px;">
                            <div style="background:#030712; padding:8px 12px; border-radius:8px;">
                                <span style="color:#64748b; font-size:10px; display:block;">EMAIL ADDRESS</span>
                                <strong id="profileEmail" style="color:#e2e8f0;">ayushkaushik1441@gmail.com</strong>
                            </div>
                            <div style="background:#030712; padding:8px 12px; border-radius:8px;">
                                <span style="color:#64748b; font-size:10px; display:block;">LOCATION</span>
                                <strong id="profileLocation" style="color:#e2e8f0;">New Delhi, India</strong>
                            </div>
                            <div style="background:#030712; padding:8px 12px; border-radius:8px;">
                                <span style="color:#64748b; font-size:10px; display:block;">ID PROOF / KYC</span>
                                <strong id="profileIdProof" style="color:#10b981;">KYC Verified (IND-7892-AAYU)</strong>
                            </div>
                            <div style="background:#030712; padding:8px 12px; border-radius:8px;">
                                <span style="color:#64748b; font-size:10px; display:block;">STORAGE GUARANTEE</span>
                                <strong id="profileUserId" style="color:#c084fc; font-family:monospace;">In-Memory + SSD WAL Synced</strong>
                            </div>
                        </div>

                        <div style="background:#030712; padding:10px 12px; border-radius:8px; margin-bottom:14px;">
                            <span style="color:#64748b; font-size:10px; display:block;">BIO & INTENT SPECIFICATION</span>
                            <p id="profileBio" style="margin:4px 0 0; color:#cbd5e1; font-size:13px;">Data Engineering Pipelines, Kafka Event Streams & In-Memory Vector Optimization</p>
                        </div>

                        <!-- Action Buttons -->
                        <div style="display:flex; gap:10px; flex-wrap:wrap;">
                            <button onclick="downloadMyProfileJSON()" class="btn-primary" style="background:#10b981; flex:1; min-width:200px;">📥 Download My Profile (JSON)</button>
                            <button onclick="exportJSON()" class="btn-primary" style="background:#0284c7; flex:1; min-width:200px;">📦 Export All AayuDB Users (JSON)</button>
                        </div>
                    </div>
                </div>

                <!-- Inline Edit Profile Form Drawer -->
                <div id="editProfileDrawer" style="display:none; margin-top:16px; padding-top:16px; border-top:1px dashed #334155;">
                    <div style="font-size:13px; font-weight:bold; color:#38bdf8; margin-bottom:10px;">✏️ Update Profile (Direct AayuDB Mutation + SSD WAL Flush)</div>
                    <form onsubmit="handleUpdateProfile(event)" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:10px;">
                        <div class="form-group" style="margin:0;">
                            <label>Location</label>
                            <input type="text" id="editLocation" value="New Delhi, India" required>
                        </div>
                        <div class="form-group" style="margin:0;">
                            <label>Enterprise Role</label>
                            <input type="text" id="editRole" value="Lead Data Engineer & Architect" required>
                        </div>
                        <div class="form-group" style="margin:0;">
                            <label>ID Proof / KYC Doc</label>
                            <input type="text" id="editIdProof" value="KYC Verified (Govt ID: IND-7892-AAYU)" required>
                        </div>
                        <div class="form-group" style="margin:0;">
                            <label>Avatar Vector Preset</label>
                            <select id="editAvatar" onchange="previewAvatar(this.value)">
                                <option value="cyber">Cyber Circuit (Cyan & Blue)</option>
                                <option value="neural">Neural Network (Synapse Core)</option>
                                <option value="shield">Verified Shield (Security)</option>
                                <option value="avatar">Profile Contours (Purple Glow)</option>
                            </select>
                        </div>
                        <div class="form-group" style="grid-column: 1 / -1; margin:0;">
                            <label>Bio / Intent</label>
                            <input type="text" id="editBio" value="Data Engineering Pipelines, Kafka Event Streams & In-Memory Vector Optimization" required>
                        </div>
                        <div style="grid-column: 1 / -1; display:flex; gap:10px; margin-top:4px;">
                            <button type="submit" class="btn-primary" style="background:#2563eb; flex:1;">💾 Save to AayuDB & WAL Disk</button>
                            <button type="button" onclick="toggleEditProfile()" style="background:#334155; color:#fff; border:none; padding:10px 16px; border-radius:8px; cursor:pointer;">Cancel</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="grid-2">
                <!-- Registration Form -->
                <div class="card">
                    <div class="card-header">
                        <div class="card-title"><span>👤</span> Register New User</div>
                        <span class="badge badge-engineer">POST /api/register</span>
                    </div>
                    <form id="regForm" onsubmit="handleRegister(event)">
                        <div class="form-group">
                            <label>Username</label>
                            <input type="text" id="regUser" placeholder="e.g. ayush_kaushik" required>
                        </div>
                        <div class="form-group">
                            <label>Email Address</label>
                            <input type="email" id="regEmail" placeholder="user@enterprise.com" required>
                        </div>
                        <div class="form-group">
                            <label>Password (Auto-Hashed with SHA-256)</label>
                            <input type="password" id="regPass" placeholder="••••••••" required>
                        </div>
                        <div class="form-group">
                            <label>Location & City</label>
                            <input type="text" id="regLocation" placeholder="e.g. New Delhi, India" value="New Delhi, India">
                        </div>
                        <div class="form-group">
                            <label>Govt ID / KYC Proof Document</label>
                            <input type="text" id="regIdProof" placeholder="e.g. KYC Verified (IND-7892-AAYU)" value="KYC Verified (IND-7892-AAYU)">
                        </div>
                        <div class="form-group">
                            <label>Enterprise Role</label>
                            <select id="regRole">
                                <option value="Data Engineer">Data Engineer</option>
                                <option value="Lead Data Engineer & Architect">Lead Data Engineer & Architect</option>
                                <option value="Enterprise Mentor & CTO">Enterprise Mentor & CTO</option>
                                <option value="AAYU Language Creator">AAYU Language Creator</option>
                                <option value="Silicon Architect">Silicon Architect</option>
                            </select>
                        </div>
                        <button type="submit" class="btn-primary">Register into AayuDB & WAL</button>
                    </form>
                </div>

                <!-- Login Verification Form with 2FA / OTP -->
                <div class="card">
                    <div class="card-header">
                        <div class="card-title"><span>🔑</span> Verify Login & 2-Step OTP</div>
                        <span class="badge badge-admin">POST /api/login</span>
                    </div>
                    <form id="loginForm" onsubmit="handleLogin(event)">
                        <div class="form-group">
                            <label>Username</label>
                            <input type="text" id="loginUser" placeholder="e.g. ayush" value="ayush" required>
                        </div>
                        <div class="form-group">
                            <label>Password</label>
                            <input type="password" id="loginPass" placeholder="Password" value="demo123" required>
                        </div>
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:14px; background:#030712; padding:8px 12px; border-radius:8px; border:1px solid #1e293b;">
                            <input type="checkbox" id="login2FA" checked style="width:auto; cursor:pointer;">
                            <label for="login2FA" style="font-size:12px; color:#38bdf8; cursor:pointer; margin:0; font-weight:600;">🔒 Two-Step OTP Verification (Zero-Trust Security)</label>
                        </div>

                        <!-- Step 2 OTP Modal (Appears when 2FA triggered) -->
                        <div id="otpSection" style="display:none; background:#0f172a; border:1px solid #38bdf8; border-radius:12px; padding:16px; margin-bottom:14px; box-shadow:0 0 20px rgba(56, 189, 248, 0.2);">
