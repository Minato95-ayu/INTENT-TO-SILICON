app TestRender2
action render_node(node)
    let type = node["type"]
    let children = node["children"]
    
    print("TYPE IS: " + type)
    print("CHILDREN IS: ")
    print(children)
    
    let ch_len = list::length(children)
    print("CH_LEN: " + ch_len)
    
    let i = 0
    while i < ch_len
        print("CHILD " + i + " IS: ")
        print(children[i])
        
        let child_type = children[i]["type"]
        if child_type == "heading"
            print("RECURSING!")
            render_node(children[i])
        end
        i = i + 1
    end
    return ""
end

action main
    let sample_node = {
        "type": "Column",
        "props": {},
        "children": [
            {
                "type": "heading",
                "props": {},
                "children": ["Hello AAYU SSR!"]
            }
        ]
    }
    render_node(sample_node)
end
run main
