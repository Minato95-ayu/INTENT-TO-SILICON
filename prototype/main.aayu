# 1. Entities
entity Complaint.
    text name.
end.

entity Officer.
    text name.
end.

entity Citizen.
    text name.
end.

entity Evidence.
    text name.
end.

entity Investigation.
    text name.
end.

entity Report.
    text name.
end.

# 2. Relations
relation Citizen one_to_many Complaint.
relation Officer one_to_many Investigation.
relation Complaint one_to_one Investigation.
relation Complaint one_to_many Evidence.
relation Investigation one_to_one Report.

# 3. Roles
role Admin.
role Officer.
role Citizen.

# 4. Workflows
workflow ComplaintWorkflow for Complaint.
    step Filed.
    step Verified.
    step Investigated.
    step Action.
    step Closed.
end.

# 5. CRUD Endpoints
crud Complaint.
crud Officer.
crud Citizen.
crud Evidence.
crud Investigation.
crud Report.

# 6. UI DSL
page Dashboard.
    heading "Police System Dashboard".
    row.
        card.
            heading "Complaints".
        end.
        card.
            heading "Officers".
        end.
        card.
            heading "Citizens".
        end.
        card.
            heading "Evidences".
        end.
    end.
end.

task dashboardRoute with req.
    map context.
    return render "Dashboard.html" with context.
end.

get "/dashboard" to dashboardRoute.

