# AAYU Blog Platform

model Post
    title: string
    body: string
    author: string
    date: string
end

state posts = []
state view_state = "list" # list, create, view
state active_post = null

state new_title = ""
state new_body = ""
state new_author = "Anonymous"

fn load_posts()
    posts = db_find("Post")
end

fn view_post(post_id)
    # mock logic for viewing a post
    view_state = "view"
end

fn publish()
    db_insert("Post", {
        "title": new_title,
        "body": new_body,
        "author": new_author,
        "date": "Today"
    })
    view_state = "list"
    load_posts()
end

load_posts()

Page BlogPage
    layout Column
        text "AAYU Tech Blog"
        
        layout Row
            button "Home" on_click: { view_state = "list" }
            button "New Post" on_click: { view_state = "create" }
        end
        
        if view_state == "list"
            for p in posts
                layout Column
                    text p.title
                    text "By " + p.author
                    button "Read More" on_click: view_post(p.id)
                end
            end
        end
        
        if view_state == "create"
            layout Column
                input "Title" bind: new_title
                input "Body" bind: new_body
                button "Publish" on_click: publish()
            end
        end
    end
end
