                            Text "Status: live" fontSize="12px" color="#818cf8"
                        end
                        Card backgroundColor="#111827" borderRadius="14px" padding="22px" border="1px solid #1f2937" flexDirection="column" gap="8px"
                            Text "How Computers Think" fontSize="20px" fontWeight="800" color="#ffffff"
                            Text "A YouTube Shorts channel, Zero to Research, that explains how computers work for engineers and ML practitioners." fontSize="14px" color="#9ca3af" lineHeight="1.6"
                            Text "Status: publishing" fontSize="12px" color="#818cf8"
                        end
                        Card backgroundColor="#111827" borderRadius="14px" padding="22px" border="1px solid #1f2937" flexDirection="column" gap="8px"
                            Text "Foundations" fontSize="20px" fontWeight="800" color="#ffffff"
                            Text "Mini-Database-Engine, Authentication-System and Mini-API-Server: the primitives under Adumate, AAYU and I2S." fontSize="14px" color="#9ca3af" lineHeight="1.6"
