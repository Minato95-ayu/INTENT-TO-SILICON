action render_node(node)
    if typeof(node) == "str"
        return node
    end
    print("Node type is: " + node["type"])
    let type = node["type"]
    let props = node["props"]
    let children = node["children"]
    
    let tag = "div"
    let style = ""
    if type == "Column"
        tag = "div"
        style = " style=\"display: flex; flex-direction: column;\""
    elif type == "heading"
        tag = "h1"
    end
    
    let html = "<" + tag + style + ">"
    
    let i = 0
    let ch_len = list::length(children)
    while i < ch_len
        let child_html = render_node(children[i])
        html = html + child_html
        i = i + 1
    end
    
    html = html + "</" + tag + ">"
    return html
end

let sample_node = {
    "type": "Column",
    "props": {},
    "children": [
        {
            "type": "heading",
            "props": {},
            "children": ["Hello AAYU SSR!"]
        }
    ]
}

print(render_node(sample_node))
