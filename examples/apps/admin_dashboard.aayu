# AAYU Admin Dashboard

state total_users = 1500
state active_sessions = 342
state server_load = "42%"

state view = "overview"

Page Dashboard
    layout Row
        # Sidebar
        layout Column
            text "Admin Panel"
            button "Overview" on_click: { view = "overview" }
            button "Users" on_click: { view = "users" }
            button "Settings" on_click: { view = "settings" }
        end
        
        # Main Content
        if view == "overview"
            layout Column
                text "System Status"
                layout Row
                    text "Total Users: " + string(total_users)
                    text "Active Sessions: " + string(active_sessions)
                    text "Server Load: " + server_load
                end
            end
        end
        
        if view == "users"
            text "User management coming soon..."
        end
        
        if view == "settings"
            text "System settings coming soon..."
        end
    end
end
