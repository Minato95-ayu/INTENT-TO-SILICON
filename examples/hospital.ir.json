{
  "ir_version": "1.0",
  "system": {
    "name": "AAYU_App"
  },
  "entities": [
    {
      "name": "Patient",
      "fields": [
        {
          "type": "text",
          "name": "name"
        },
        {
          "type": "text",
          "name": "dob"
        },
        {
          "type": "text",
          "name": "blood_group"
        },
        {
          "type": "text",
          "name": "history"
        }
      ]
    },
    {
      "name": "Doctor",
      "fields": [
        {
          "type": "text",
          "name": "name"
        },
        {
          "type": "text",
          "name": "specialization"
        },
        {
          "type": "number",
          "name": "experience"
        }
      ]
    },
    {
      "name": "Appointment",
      "fields": [
        {
          "type": "text",
          "name": "date"
        },
        {
          "type": "text",
          "name": "time"
        },
        {
          "type": "text",
          "name": "status"
        },
        {
          "type": "number",
          "name": "patient_id"
        },
        {
          "type": "number",
          "name": "doctor_id"
        }
      ]
    }
  ],
  "relations": [
    {
      "source": "Doctor",
      "type": "one_to_many",
      "target": "Appointment"
    },
    {
      "source": "Patient",
      "type": "one_to_many",
      "target": "Appointment"
    }
  ],
  "roles": [
    {
      "name": "Admin"
    },
    {
      "name": "DoctorRole"
    },
    {
      "name": "Receptionist"
    }
  ],
  "permissions": [
    {
      "role": "Admin",
      "action": "create",
      "target": "Doctor"
    },
    {
      "role": "Admin",
      "action": "delete",
      "target": "Doctor"
    },
    {
      "role": "Receptionist",
      "action": "create",
      "target": "Patient"
    },
    {
      "role": "Receptionist",
      "action": "create",
      "target": "Appointment"
    },
    {
      "role": "DoctorRole",
      "action": "update",
      "target": "Appointment"
    }
  ],
  "pages": [
    {
      "name": "HospitalDashboard"
    }
  ],
  "workflows": [
    {
      "name": "PatientVisit",
      "entity": "Appointment",
      "steps": [
        "Scheduled",
        "CheckedIn",
        "InConsultation",
        "Completed"
      ]
    }
  ],
  "routes": [
    {
      "path": "/dashboard",
      "method": "GET",
      "handler": "handle_dashboard"
    }
  ],
  "modules": [
    {
      "name": "http"
    },
    {
      "name": "db"
    },
    {
      "name": "auth"
    },
    {
      "name": "rbac"
    }
  ],
  "features": [
    "ui",
    "database",
    "rbac",
    "api",
    "workflow"
  ]
}