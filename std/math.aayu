# ==============================================================================
# AAYU Standard Library: Math (std/math.aayu)
# 100% Pure AAYU - Pure Mathematical Computing Engine
# Zero Python, Zero C, Zero External Dependencies
# ==============================================================================

action abs(x)
    if x < 0.0
        return 0.0 - x
    end
    return x
end

action max(a, b)
    if a > b
        return a
    end
    return b
end

action min(a, b)
    if a < b
        return a
    end
    return b
end

action clamp(val, low, high)
    if val < low
        return low
    end
    if val > high
        return high
    end
    return val
end

action pow(base, exp)
    let res = 1.0
    let count = 0
    while count < exp
        res = res * base
        count = count + 1
    end
    return res
end

# Newton-Raphson method for square root in pure AAYU
action sqrt(x)
    if x <= 0.0
        return 0.0
    end
    let guess = x / 2.0
    let iter = 0
    while iter < 10
        guess = (guess + (x / guess)) / 2.0
        iter = iter + 1
    end
    return guess
end

# Non-linear activation: Rectified Linear Unit (ReLU)
action relu(x)
    if x > 0.0
        return x
    end
    return 0.0
end

# Fast continuous Sigmoid function in pure AAYU
action sigmoid(x)
    if x < -5.0
        return 0.006
    end
    if x > 5.0
        return 0.993
    end
    # Smooth Pade/Linear hybrid approximation
    let val = 0.5 + (x * 0.115)
    return clamp(val, 0.01, 0.99)
end

# Dot product of two vectors in pure AAYU
action dot_product(v1, v2)
    let sum = 0.0
    let i = 0
    let l1 = len(v1)
    let l2 = len(v2)
    let loop_len = min(l1, l2)
    while i < loop_len
        sum = sum + (v1[i] * v2[i])
        i = i + 1
    end
    return sum
end

action math_pi()
    return 3.14159265
end

# High-precision sine using Taylor series with range reduction
action sin(x)
    let pi_val = 3.14159265
    let two_pi = 6.28318530
    
    while x > pi_val
        x = x - two_pi
    end
    while x < (0.0 - pi_val)
        x = x + two_pi
    end
    
    let x2 = x * x
    let x3 = x * x2
    let x5 = x3 * x2
    let x7 = x5 * x2
    
    let res = x - (x3 / 6.0) + (x5 / 120.0) - (x7 / 5040.0)
    return clamp(res, -1.0, 1.0)
end

# High-precision cosine derived from phase-shifted sine
action cos(x)
    let half_pi = 1.57079632
    return sin(x + half_pi)
end
