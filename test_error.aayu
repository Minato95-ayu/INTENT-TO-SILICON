action risky_task(value)
    if value == 0
        throw "Error: Cannot divide by zero!"
    end
    return 100 / value
end

print("Starting application...")
try
    let result = risky_task(0)
    print(result)
catch (e)
    print("Caught an exception gracefully:")
    print(e)
finally
    print("Cleanup complete.")
end
