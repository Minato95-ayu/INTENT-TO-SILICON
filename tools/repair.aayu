# ==============================================================================
# AAYU AUTONOMOUS CODE REPAIR & HEALER (tools/repair.aayu)
# 100% Pure Self-Hosted AAYU (.aayu)
# Automatically heals Python/JS syntax leaks, missing 'end' blocks, and colons
# Zero External Dependencies | Intent-to-Silicon Self-Healing
# ==============================================================================
import "std/fs.aayu"

action is_space(c)
    if c == " "
        return 1
    end
    if c == "\t"
        return 1
    end
    if c == "\r"
        return 1
    end
    if c == "\n"
        return 1
    end
    return 0
end

action trim_line(s)
    let l = len(s)
    if l == 0
        return ""
    end
    let start = 0
    while start < l
        if is_space(s[start]) == 1
            start = start + 1
        else
            let finish = l - 1
            while finish >= start
                if is_space(s[finish]) == 1
                    finish = finish - 1
                else
                    let res = ""
                    let k = start
                    while k <= finish
                        res = res + s[k]
                        k = k + 1
                    end
                    return res
                end
            end
            return ""
        end
    end
    return ""
end

action string_starts_with(s, prefix)
    let sl = len(s)
    let pl = len(prefix)
    if sl < pl
        return 0
    end
    let i = 0
    while i < pl
        if s[i] != prefix[i]
            return 0
        end
        i = i + 1
    end
    return 1
end

action replace_keyword(line, old_kw, new_kw)
    let trimmed = trim_line(line)
    if string_starts_with(trimmed, old_kw) == 1
        let old_len = len(old_kw)
        let rest = ""
        let i = old_len
        let l = len(trimmed)
        while i < l
            rest = rest + trimmed[i]
            i = i + 1
        end
        return new_kw + rest
    end
    return line
end

# Strip trailing colon if present
action strip_trailing_colon(line)
    let l = len(line)
    if l == 0
        return ""
    end
    let last_idx = l - 1
    while last_idx >= 0
        if is_space(line[last_idx]) == 1
            last_idx = last_idx - 1
        else
            if line[last_idx] == ":"
                let res = ""
                let k = 0
                while k < last_idx
                    res = res + line[k]
                    k = k + 1
                end
                return res
            end
            return line
        end
    end
    return line
end

action split_code_lines(content)
    let lines = []
    let cur = ""
    let l = len(content)
    let i = 0
    while i < l
        let ch = content[i]
        if ch == "\n"
            lines = lines + [cur]
            cur = ""
        else
            if ch != "\r"
                cur = cur + ch
            end
        end
        i = i + 1
    end
    if len(cur) > 0
        lines = lines + [cur]
    end
    return lines
end

action main()
    let target = env_get("AAYU_TARGET")
    if target == null
        target = "hello.aayu"
    end
    if len(target) == 0
        target = "hello.aayu"
    end

    print("==================================================")
    print("      AAYU AUTONOMOUS CODE REPAIR ENGINE (v1.5.0) ")
    print("==================================================")
    print("Target: " + target)
    print("Engine: Pure AAYU Self-Healing AST Normalizer")
    print("--------------------------------------------------")

    let content = read_text(target)
    if content == null
        print("[AAYU Repair Error] Cannot read source file: " + target)
        return
    end

    let lines = split_code_lines(content)
    let num_lines = len(lines)
    let healed_lines = []
    let repairs_count = 0
    let open_blocks = 0

    let idx = 0
    while idx < num_lines
        let original = lines[idx]
        let current = original

        # 1. Heal: 'def ' -> 'action '
        let after_def = replace_keyword(current, "def ", "action ")
        if after_def != current
            repairs_count = repairs_count + 1
            current = after_def
        end

        # 2. Heal: 'function ' -> 'action '
        let after_func = replace_keyword(current, "function ", "action ")
        if after_func != current
            repairs_count = repairs_count + 1
            current = after_func
        end

        # 3. Heal: 'var ' -> 'let '
        let after_var = replace_keyword(current, "var ", "let ")
        if after_var != current
            repairs_count = repairs_count + 1
            current = after_var
        end

        # 4. Heal: 'const ' -> 'let '
        let after_const = replace_keyword(current, "const ", "let ")
        if after_const != current
            repairs_count = repairs_count + 1
            current = after_const
        end

        # 5. Heal: Trailing colons on block headers (action, if, while)
        let trimmed_cur = trim_line(current)
        if string_starts_with(trimmed_cur, "action ") == 1
            open_blocks = open_blocks + 1
            let stripped = strip_trailing_colon(current)
            if stripped != current
                repairs_count = repairs_count + 1
                current = stripped
            end
        end
        if string_starts_with(trimmed_cur, "if ") == 1
            open_blocks = open_blocks + 1
            let stripped = strip_trailing_colon(current)
            if stripped != current
                repairs_count = repairs_count + 1
                current = stripped
            end
        end
        if string_starts_with(trimmed_cur, "while ") == 1
            open_blocks = open_blocks + 1
            let stripped = strip_trailing_colon(current)
            if stripped != current
                repairs_count = repairs_count + 1
                current = stripped
            end
        end
        if string_starts_with(trimmed_cur, "model ") == 1
            open_blocks = open_blocks + 1
        end
        if string_starts_with(trimmed_cur, "route ") == 1
            open_blocks = open_blocks + 1
        end

        if trimmed_cur == "end"
            open_blocks = open_blocks - 1
        end

        healed_lines = healed_lines + [current]
        idx = idx + 1
    end

    # 6. Heal: Missing closing 'end' statements
    while open_blocks > 0
        healed_lines = healed_lines + ["end"]
        open_blocks = open_blocks - 1
        repairs_count = repairs_count + 1
    end

    # Write healed code back to disk
    let output_code = ""
    let h_idx = 0
    let total_healed = len(healed_lines)
    while h_idx < total_healed
        output_code = output_code + healed_lines[h_idx] + "\n"
        h_idx = h_idx + 1
    end

    write_text(target, output_code)

    print("--------------------------------------------------")
    if repairs_count > 0
        print("✓ [AAYU Self-Healing] Successfully healed " + repairs_count + " syntax anomaly(ies) in '" + target + "'!")
        print("  Converted to 100% canonical AAYU Intent-to-Silicon syntax.")
    else
        print("✓ [AAYU Self-Healing] File '" + target + "' is already 100% canonical. No repairs needed.")
    end
    print("==================================================")
end

main()
