        async function loadEvents() {
            try {
                const res = await fetch('/api/events');
                const data = await res.json();
                const tbody = document.getElementById('eventTableBody');
                if (!tbody) return;
                if (!data.events || data.events.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:#64748b;">No events in stream yet.</td></tr>';
                    return;
                }
                tbody.innerHTML = data.events.map((e, idx) => `
                    <tr>
                        <td><strong>#${e.id}</strong></td>
                        <td><span class="badge badge-engineer">Partition ${idx % 3}</span></td>
                        <td><span class="badge ${e.topic.includes('kyc') ? 'badge-cto' : 'badge-admin'}">${e.topic}</span></td>
                        <td style="font-family:monospace; font-size:11px; color:#cbd5e1; max-width:240px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">${e.payload}</td>
                        <td style="color:#94a3b8; font-size:11px;">${e.timestamp}</td>
                        <td style="color:#10b981; font-weight:bold;">&lt; 0.42ms</td>
                        <td><span style="color:#34d399; font-weight:bold; font-size:11px;">✓ ACKNOWLEDGED</span></td>
                    </tr>
                `).join('');
            } catch (err) {
                console.error('Failed to load events:', err);
            }
        }

        async function publishEvent(e) {
