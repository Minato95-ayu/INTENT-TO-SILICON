# ==============================================================================
# AAYU MIT Admission Project: Nexus AI Engine
# 
# Demonstrating:
# 1. Native UI Generation (Virtual DOM -> HTML/SSE)
# 2. Secure Local Database (Storage Preserver)
# 3. High-Speed Compute Engine (Simulating LLM Token Processing)
# ==============================================================================

model ChatMemory {
    session_id: String
    user_query: String
    ai_response: String
    compute_time_ms: Int
}

Page NexusChat
    state user_input = ""
    state chat_history = "System: Nexus AI Initialized.\n\n"
    state is_computing = ""

    action compute_inference()
        is_computing = "Thinking..."
        
        let current_msg = user_input
        user_input = ""
        chat_history = chat_history + "You: " + current_msg + "\n"
        
        # ========================================================
        # AAYU Native Nano-LLM (Zero-Dependency)
        # ========================================================
        let vocab = ["Nexus", "is", "thinking", "about", "your", "query.", "AAYU", "engine", "is", "fast", "and", "secure.", "Hello,", "I", "am", "ready.", "MIT", "is", "great,", "yes!"]
        let vocab_size = 20
        
        let response = ""
        let total_weights = 0
        let step = 0
        
        # Seed includes chat history length for extra variation
        let seed = len(current_msg) + len(chat_history)
        if seed == 0
            seed = 1
        end
        
        # Calculate tokens_to_generate without parentheses
        let seed_div_4 = seed / 4
        let seed_div_floor = math::floor(seed_div_4)
        let seed_mul = seed_div_floor * 4
        let rem = seed - seed_mul
        let tokens_to_generate = 5 + rem
        
        while step < tokens_to_generate
            # LCG pseudorandom step (seed = (seed * 101 + 11) % 1000)
            let seed_next = seed * 101
            seed = seed_next + 11
            
            let s_div = seed / 1000
            let s_div_floor = math::floor(s_div)
            let s_mul = s_div_floor * 1000
            seed = seed - s_mul
            
            # Map seed to vocab index
            let act_div = seed / vocab_size
            let act_div_floor = math::floor(act_div)
            let act_mul = act_div_floor * vocab_size
            let activation = seed - act_mul
            let int_activation = math::floor(activation)
            
            # Fetch token
            let token = vocab[int_activation]
            response = response + token + " "
            
            step = step + 1
        end
        chat_history = chat_history + "AI: " + response + "\n\n"
        print(chat_history)
        is_computing = ""
        
        # Store history securely
        insert ChatMemory { session_id = "mit_demo" user_query = current_msg ai_response = response compute_time_ms = total_weights }
    end

    Column padding=20 gap=20
        Text "Nexus AI (AAYU Engine)" size=32 bold=true color="white"
        
        Container padding=20 backgroundColor="#1e293b" radius=10
            Text "---------------------------------------------------"
            Text chat_history
            Text "---------------------------------------------------"
            Text is_computing
        end
        
        Row
            Input placeholder="Type your message here..." flex=1
                bind user_input
            end
            Button "Send Message" onClick=compute_inference
        end
    end
end

