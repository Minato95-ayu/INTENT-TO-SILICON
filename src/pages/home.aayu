    page HomePage display="flex" flexDirection="column" width="100vw" height="100vh" margin="0" overflow="hidden" backgroundColor="#eaeded"
        import components.navbar
        
        Row width="100%" padding="8px 40px" backgroundColor="#232f3e" gap="20px" alignItems="center"
            Row alignItems="center" gap="5px" cursor="pointer" onClick="go_generic"
                Icon name="bars" color="#fff"
                Text "All" color="#fff" fontWeight="bold"
            end
            Text "Today's Deals" color="#fff" fontSize="14px" cursor="pointer" onClick="go_generic"
            Text "Customer Service" color="#fff" fontSize="14px" cursor="pointer" onClick="go_generic"
            Text "Registry" color="#fff" fontSize="14px" cursor="pointer" onClick="go_generic"
            Text "Gift Cards" color="#fff" fontSize="14px" cursor="pointer" onClick="go_generic"
            Text "Sell" color="#fff" fontSize="14px" cursor="pointer" onClick="go_generic"
        end
        
        Column width="100%" height="100%" overflowY="auto" padding="0" gap="0"
            
            Container width="100%" padding="60px 40px" backgroundColor="#0f1111" alignItems="center" justifyContent="center"
                Column alignItems="center" gap="15px"
                    Text "Discover the Future of Tech." fontSize="48px" fontWeight="900" color="#fff"
                    Text "Up to 40% off on flagship devices. Limited time only." fontSize="18px" color="#a1a1aa"
                end
            end
            
            Column padding="40px" gap="30px" backgroundColor="#eaeded"
                Text "Trending Electronics" fontSize="28px" fontWeight="bold" color="#0f1111"
                
                Grid gridTemplateColumns="repeat(auto-fill, minmax(320px, 1fr))" gap="20px" width="100%"
                    
                    Card backgroundColor="#fff" borderRadius="8px" padding="30px" border="1px solid #ddd" display="flex" flexDirection="column" gap="15px" hoverBackgroundColor="#f9f9f9"
                        Container height="220px" backgroundColor="#f0f2f2" borderRadius="8px" justifyContent="center" alignItems="center"
                            Icon name="mobile-alt" color="#565959" fontSize="80px"
                        end
                        Text "NovaPhone 15 Pro, 256GB" fontSize="20px" fontWeight="bold" color="#0f1111"
                        Row alignItems="center" gap="5px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star-half-alt" color="#de7921" fontSize="16px"
                            Text "14,092" color="#007185" fontSize="14px"
                        end
                        Text "$999.00" fontSize="28px" fontWeight="900" color="#0f1111"
                        Text "FREE Delivery Tomorrow" fontSize="12px" color="#565959"
                        Button "Add to Cart" onClick="add_iphone" backgroundColor="#ffd814" color="#0f1111" padding="10px" borderRadius="24px" fontWeight="bold" border="none" hoverBackgroundColor="#f7ca00"
                    end
                    
                    Card backgroundColor="#fff" borderRadius="8px" padding="30px" border="1px solid #ddd" display="flex" flexDirection="column" gap="15px" hoverBackgroundColor="#f9f9f9"
                        Container height="220px" backgroundColor="#f0f2f2" borderRadius="8px" justifyContent="center" alignItems="center"
                            Icon name="laptop" color="#565959" fontSize="80px"
                        end
                        Text "NovaBook M3 Max, 16-inch" fontSize="20px" fontWeight="bold" color="#0f1111"
                        Row alignItems="center" gap="5px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Text "8,231" color="#007185" fontSize="14px"
                        end
                        Text "$2499.00" fontSize="28px" fontWeight="900" color="#0f1111"
                        Text "FREE Delivery by Wednesday" fontSize="12px" color="#565959"
                        Button "Add to Cart" onClick="add_macbook" backgroundColor="#ffd814" color="#0f1111" padding="10px" borderRadius="24px" fontWeight="bold" border="none" hoverBackgroundColor="#f7ca00"
                    end
                    
                    Card backgroundColor="#fff" borderRadius="8px" padding="30px" border="1px solid #ddd" display="flex" flexDirection="column" gap="15px" hoverBackgroundColor="#f9f9f9"
                        Container height="220px" backgroundColor="#f0f2f2" borderRadius="8px" justifyContent="center" alignItems="center"
                            Icon name="headphones" color="#565959" fontSize="80px"
                        end
                        Text "SonicPods Pro" fontSize="20px" fontWeight="bold" color="#0f1111"
                        Row alignItems="center" gap="5px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star-half-alt" color="#de7921" fontSize="16px"
                            Text "21,805" color="#007185" fontSize="14px"
                        end
                        Text "$249.00" fontSize="28px" fontWeight="900" color="#0f1111"
                        Text "FREE Delivery Tomorrow" fontSize="12px" color="#565959"
                        Button "Add to Cart" onClick="add_headphones" backgroundColor="#ffd814" color="#0f1111" padding="10px" borderRadius="24px" fontWeight="bold" border="none" hoverBackgroundColor="#f7ca00"
                    end
                    
                    Card backgroundColor="#fff" borderRadius="8px" padding="30px" border="1px solid #ddd" display="flex" flexDirection="column" gap="15px" hoverBackgroundColor="#f9f9f9"
                        Container height="220px" backgroundColor="#f0f2f2" borderRadius="8px" justifyContent="center" alignItems="center"
                            Icon name="gamepad" color="#565959" fontSize="80px"
                        end
                        Text "PlayBox Station 5" fontSize="20px" fontWeight="bold" color="#0f1111"
                        Row alignItems="center" gap="5px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Text "45,112" color="#007185" fontSize="14px"
                        end
                        Text "$499.00" fontSize="28px" fontWeight="900" color="#0f1111"
                        Text "FREE Delivery by Friday" fontSize="12px" color="#565959"
                        Button "Add to Cart" onClick="add_ps5" backgroundColor="#ffd814" color="#0f1111" padding="10px" borderRadius="24px" fontWeight="bold" border="none" hoverBackgroundColor="#f7ca00"
                    end

                    Card backgroundColor="#fff" borderRadius="8px" padding="30px" border="1px solid #ddd" display="flex" flexDirection="column" gap="15px" hoverBackgroundColor="#f9f9f9"
                        Container height="220px" backgroundColor="#f0f2f2" borderRadius="8px" justifyContent="center" alignItems="center"
                            Icon name="camera" color="#565959" fontSize="80px"
                        end
                        Text "Lumina Alpha 7R" fontSize="20px" fontWeight="bold" color="#0f1111"
                        Row alignItems="center" gap="5px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star-half-alt" color="#de7921" fontSize="16px"
                            Text "3,401" color="#007185" fontSize="14px"
                        end
                        Text "$3299.00" fontSize="28px" fontWeight="900" color="#0f1111"
                        Text "FREE Delivery by Monday" fontSize="12px" color="#565959"
                        Button "Add to Cart" onClick="add_camera" backgroundColor="#ffd814" color="#0f1111" padding="10px" borderRadius="24px" fontWeight="bold" border="none" hoverBackgroundColor="#f7ca00"
                    end
                    
                    Card backgroundColor="#fff" borderRadius="8px" padding="30px" border="1px solid #ddd" display="flex" flexDirection="column" gap="15px" hoverBackgroundColor="#f9f9f9"
                        Container height="220px" backgroundColor="#f0f2f2" borderRadius="8px" justifyContent="center" alignItems="center"
                            Icon name="clock" color="#565959" fontSize="80px"
                        end
                        Text "NovaWatch Ultra" fontSize="20px" fontWeight="bold" color="#0f1111"
                        Row alignItems="center" gap="5px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Icon name="star" color="#de7921" fontSize="16px"
                            Text "11,234" color="#007185" fontSize="14px"
                        end
                        Text "$799.00" fontSize="28px" fontWeight="900" color="#0f1111"
                        Text "FREE Delivery Tomorrow" fontSize="12px" color="#565959"
                        Button "Add to Cart" onClick="add_watch" backgroundColor="#ffd814" color="#0f1111" padding="10px" borderRadius="24px" fontWeight="bold" border="none" hoverBackgroundColor="#f7ca00"
                    end

                end
            end
        end
    end
