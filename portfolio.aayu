            Container flexShrink="0" width="100%" height="700px" padding="0 48px" alignItems="center" justifyContent="center" backgroundColor="#0d1220"
                Column gap="26px" width="100%" maxWidth="1000px"
                    Text "Work" fontSize="34px" fontWeight="800" color="#ffffff"
                    Grid gridTemplateColumns="repeat(auto-fit, minmax(280px, 1fr))" gap="18px" width="100%"
                        Card backgroundColor="#111827" borderRadius="14px" padding="22px" border="1px solid #1f2937" flexDirection="column" gap="8px"
                            Text "AAYU" fontSize="20px" fontWeight="800" color="#ffffff"
                            Text "A programming language for UI, routes, data and logic, with a compiler, runtime, CLI, package manager and VS Code support." fontSize="14px" color="#9ca3af" lineHeight="1.6"
                            Text "Status: public repo, self-hosting in progress" fontSize="12px" color="#818cf8"
                        end
                        Card backgroundColor="#111827" borderRadius="14px" padding="22px" border="1px solid #1f2937" flexDirection="column" gap="8px"
                            Text "Intent-to-Silicon (I2S)" fontSize="20px" fontWeight="800" color="#ffffff"
                            Text "A research project written up as IEEE-format papers, with every claim tagged by how far it is actually built." fontSize="14px" color="#9ca3af" lineHeight="1.6"
                            Text "Status: ongoing research" fontSize="12px" color="#818cf8"
                        end
