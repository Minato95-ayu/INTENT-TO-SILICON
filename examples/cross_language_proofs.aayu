# ==========================================
# CROSS-LANGUAGE TUTORIAL PROOFS IN AAYU
# ==========================================

# 1. Python Proof: Palindrome Check (String equality)
action check_palindrome(word, expected)
    if word == expected
        print("Python Proof (Palindrome): True")
    else
        print("Python Proof (Palindrome): False")
    end
    return 0
end


# 2. JS Proof: Find Max in Array (Loops, conditions, array indexing)
action find_max(arr)
    let length = 5
    let max_val = arr[0]
    let i = 1
    
    while i < length
        let current = arr[i]
        if current > max_val
            max_val = current
        end
        i = i + 1
    end
    
    print("JS Proof (Find Max): " + max_val)
    return max_val
end


# 3. Rust Proof: Factorial (Recursion and scoping)
action factorial(n)
    if n == 0
        return 1
    end
    
    let prev = n - 1
    let sub = factorial(prev)
    let result = n * sub
    return result
end


# 4. Java Proof: Object-Oriented / Struct Simulation
model BankAccount {
    account_number: Int
    balance: Int
}

action java_oop_simulation()
    # In Java: BankAccount acc = new BankAccount(101, 500);
    insert BankAccount { account_number = 101 balance = 500 }
    
    let accounts = find BankAccount
    
    print("Java Proof (OOP Model State):")
    print(accounts)
    return 0
end


action main()
    print("=== CROSS LANGUAGE PROOFS START ===")
    
    # Python Test
    check_palindrome("radar", "radar")
    
    # JS Test
    let nums = [10, 45, 2, 99, 33]
    find_max(nums)
    
    # Rust Test
    let f = factorial(5)
    print("Rust Proof (Factorial of 5): " + f)
    
    # Java Test
    java_oop_simulation()
    
    print("===================================")
    return 0
end

run main()
