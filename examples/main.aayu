# HospitalApp - Generated by AAYU Intent-to-Application Platform
use http.
use db.
use auth.

# --- Database Models ---
entity Patient.
    text name.
    text created_at.
end.

entity Doctor.
    text name.
    text created_at.
end.

entity Appointment.
    text name.
    text created_at.
    number patient_id.
    number doctor_id.
end.

entity Prescription.
    text name.
    text created_at.
end.

entity Billing.
    text name.
    text created_at.
end.

entity Role.
    text name.
    text created_at.
end.

entity Permission.
    text name.
    text created_at.
end.

entity UserRole.
    text name.
    text created_at.
end.

entity User.
    text name.
    text created_at.
end.

# --- Frontend UI DSL ---
component AppSidebar.
    sidebar.
        text "Home".
        text "Patients".
        text "Appointments".
        text "Billing".
        text "Dashboard".
        text "Login".
    end.
end.

page Home.
    dashboard.
        AppSidebar.
        column.
            navbar.
            row.
                card.
                    heading "Welcome to HospitalApp".
                    text "System Overview and Analytics".
                    button "Get Started".
                end.
                card.
                    chart "System Activity".
                end.
            end.
            table "Patient Records".
            end.
            table "Doctor Records".
            end.
            table "Appointment Records".
            end.
            table "Prescription Records".
            end.
            table "Billing Records".
            end.
        end.
    end.
end.

page Patients.
    dashboard.
        AppSidebar.
        column.
            navbar.
            card.
                heading "Manage Patients".
                table "Patients Data".
                end.
            end.
        end.
    end.
end.

page Appointments.
    dashboard.
        AppSidebar.
        column.
            navbar.
            card.
                heading "Manage Appointments".
                table "Appointments Data".
                end.
            end.
        end.
    end.
end.

page Billing.
    dashboard.
        AppSidebar.
        column.
            navbar.
            card.
                heading "Manage Billing".
                table "Billing Data".
                end.
            end.
        end.
    end.
end.

page Dashboard.
    dashboard.
        AppSidebar.
        column.
            navbar.
            row.
                card.
                    heading "Welcome to HospitalApp".
                    text "System Overview and Analytics".
                    button "Get Started".
                end.
                card.
                    chart "System Activity".
                end.
            end.
            table "Patient Records".
            end.
            table "Doctor Records".
            end.
            table "Appointment Records".
            end.
            table "Prescription Records".
            end.
            table "Billing Records".
            end.
        end.
    end.
end.

page Login.
    dashboard.
        AppSidebar.
        column.
            navbar.
            form.
                heading "Sign In".
                input "Email Address" to login_email.
                input "Password" to login_password.
                button "Authenticate".
            end.
        end.
    end.
end.

# --- Backend Routes ---
task handle_home with req.
    return render "Home.html".
end.
route "/" to handle_home.

task handle_patients with req.
    return render "Patients.html".
end.
route "/patients" to handle_patients.

task handle_appointments with req.
    return render "Appointments.html".
end.
route "/appointments" to handle_appointments.

task handle_billing with req.
    return render "Billing.html".
end.
route "/billing" to handle_billing.

task handle_dashboard with req.
    return render "Dashboard.html".
end.
route "/dashboard" to handle_dashboard.

task handle_login with req.
    return render "Login.html".
end.
route "/login" to handle_login.

serve on 8080.