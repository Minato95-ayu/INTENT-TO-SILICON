let pos = 0
let loop = 1 == 1
let count = 0
while loop
    let ws_loop = 1 == 1
    while ws_loop
        if pos < 2
            pos = pos + 1
        else
            ws_loop = 1 == 0
        end
    end
    print(pos)
    count = count + 1
    if count == 3
        loop = 1 == 0
    end
end
print("Final pos")
print(pos)
