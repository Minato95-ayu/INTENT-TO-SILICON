import "std/crypto.aayu"

# --- 1. MATH TEST: Factorial Calculation ---
action calculate_factorial(n)
    let result = 1
    let i = 1
    while i <= n
        result = result * i
        i = i + 1
    end
    return result
end

# --- 2. ALGORITHM TEST: Bubble Sort Logic (Array Manipulation & Nested Loops) ---
action bubble_sort_swaps(arr)
    let n = len(arr)
    let i = 0
    let swaps = 0
    
    while i < n
        let j = 0
        while j < (n - i - 1)
            if arr[j] > arr[j + 1]
                # Array elements ko swap karna
                let temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
                swaps = swaps + 1
            end
            j = j + 1
        end
        i = i + 1
    end
    return swaps
end

# --- MAIN EXECUTION ---
print("=== AAYU COMPLEX ENGINE TEST ===")

# Test 1: Math
let num = 6
let fact = calculate_factorial(num)
print("1. Math - Factorial of 6 is:")
print(fact)

# Test 2: Graph/Array Logic (Nested Loops & Memory)
let data = [50, 20, 10, 40, 30]
let total_swaps = bubble_sort_swaps(data)
print("2. Algorithm - Swaps needed to sort [50, 20, 10, 40, 30]:")
print(total_swaps)

