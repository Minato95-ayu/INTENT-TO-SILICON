// AAYU Self-Hosted Lexer (Draft 1)
// This is the beginning of writing AAYU's compiler IN AAYU!

model Token
    type
    value
    line
    column
end

model LexerState
    source
    pos
    line
    column
    length
end

fn create_lexer(src)
    let state = LexerState(source: src, pos: 0, line: 1, column: 1, length: 0)
    // In future iterations, we will compute length natively
    return state
end

fn advance(state)
    state.pos = state.pos + 1
    state.column = state.column + 1
end

// TODO: Implement read_identifier and match_keyword
// As AAYU language grows its standard library (arrays, string indexing),
// we will translate the entire Python regex-based lexer into pure AAYU!

print("AAYU Self-Hosting Phase 1: Lexer structures initialized.")
