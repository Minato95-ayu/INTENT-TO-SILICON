# AAYU File Manager

model File
    name: string
    type: string
    size: string
end

state current_path = "/home/user"
state files = []
state selected_file = ""

fn load_files()
    files = [
        {"name": "Documents", "type": "folder", "size": "--"},
        {"name": "Downloads", "type": "folder", "size": "--"},
        {"name": "report.pdf", "type": "file", "size": "2.4 MB"},
        {"name": "photo.jpg", "type": "file", "size": "1.1 MB"}
    ]
end

fn select_file(f)
    selected_file = f.name
end

load_files()

Page FileManager
    layout Column
        text "AAYU File Explorer"
        text "Path: " + current_path
        
        layout Row
            # File List
            layout Column
                for f in files
                    layout Row
                        text f.name + " (" + f.type + ")"
                        button "Select" on_click: select_file(f)
                    end
                end
            end
            
            # Details Pane
            layout Column
                text "File Details"
                if selected_file != ""
                    text "Selected: " + selected_file
                else
                    text "No file selected."
                end
            end
        end
    end
end
