{
  "ir_version": "1.0",
  "system": {
    "name": "AAYU_App"
  },
  "entities": [
    {
      "name": "Product",
      "fields": [
        {
          "type": "text",
          "name": "name"
        },
        {
          "type": "text",
          "name": "description"
        },
        {
          "type": "number",
          "name": "price"
        },
        {
          "type": "number",
          "name": "stock_quantity"
        }
      ]
    },
    {
      "name": "Customer",
      "fields": [
        {
          "type": "text",
          "name": "name"
        },
        {
          "type": "text",
          "name": "email"
        }
      ]
    },
    {
      "name": "Order",
      "fields": [
        {
          "type": "text",
          "name": "order_date"
        },
        {
          "type": "text",
          "name": "status"
        },
        {
          "type": "number",
          "name": "total_amount"
        }
      ]
    },
    {
      "name": "OrderItem",
      "fields": [
        {
          "type": "number",
          "name": "quantity"
        },
        {
          "type": "number",
          "name": "price_at_purchase"
        }
      ]
    }
  ],
  "relations": [
    {
      "source": "Customer",
      "type": "one_to_many",
      "target": "Order"
    },
    {
      "source": "Order",
      "type": "one_to_many",
      "target": "OrderItem"
    },
    {
      "source": "Product",
      "type": "one_to_many",
      "target": "OrderItem"
    }
  ],
  "roles": [],
  "permissions": [],
  "pages": [],
  "workflows": [
    {
      "name": "OrderFulfillment",
      "entity": "Order",
      "steps": [
        "Pending",
        "Processing",
        "Shipped",
        "Delivered",
        "Cancelled"
      ]
    }
  ],
  "routes": [
    {
      "path": "/api/orders",
      "method": "POST",
      "handler": "create_order"
    }
  ],
  "modules": [
    {
      "name": "http"
    },
    {
      "name": "db"
    },
    {
      "name": "auth"
    }
  ],
  "features": [
    "rbac",
    "api",
    "workflow",
    "database"
  ]
}