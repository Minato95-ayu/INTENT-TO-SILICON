# ==============================================================================
# AAYU SILICON TEST: PHYSICAL STORED BYTE-FLIP TAMPER HARNESS
# Tests flipping bytes directly in stored payload mass at multiple positions:
# Header, Key, Value (Balance), Status, and Tail
# ==============================================================================
import "std/test.aayu"
import "std/liquid.aayu"

test_begin_suite("Physical Stored Byte-Flip Tamper Verification")

# Helper to mutate / flip a byte at an exact index in a string
action mutate_byte_at(src_str, target_idx)
    let l = len(src_str)
    let out = ""
    let i = 0
    while i < l
        let ch = src_str[i]
        if i == target_idx
            # Flip character: if 'X' make 'Y', else make 'X'
            if ch == "X"
                out = out + "Y"
            else
                out = out + "X"
            end
        else
            out = out + ch
        end
        i = i + 1
    end
    return out
end

let ground_truth_payload = "{\"account\": \"AYUSH_KAUSHIK\", \"balance_inr\": 4500000, \"status\": \"KYC_SETTLED_O1\"}"
let original_shard = liquid_shard_payload(ground_truth_payload)

# Verify clean baseline
assert_true(liquid_verify_checkpoints(original_shard), "Baseline: Unmodified shard verified cleanly")

# ------------------------------------------------------------------------------
# MULTI-POSITION BYTE-FLIP TESTS
# ------------------------------------------------------------------------------
# Test 1: Flip byte at index 2 (inside "LIQUID_PAYLOAD_MASS")
let tampered_pos2 = liquid_shard_payload(ground_truth_payload)
tampered_pos2["payload_mass"] = mutate_byte_at(tampered_pos2["payload_mass"], 2)
assert_false(liquid_verify_checkpoints(tampered_pos2), "Byte-Flip Position 2 (Prefix): Stored byte corruption detected")
assert_eq(liquid_reconstruct(tampered_pos2, ground_truth_payload), "ACCESS_DENIED: Layer checkpoint mismatch or tamper detected", "Byte-Flip Position 2: Access denied on corrupted byte")

# Test 2: Flip byte at index 25 (inside account key name)
let tampered_pos25 = liquid_shard_payload(ground_truth_payload)
tampered_pos25["payload_mass"] = mutate_byte_at(tampered_pos25["payload_mass"], 25)
assert_false(liquid_verify_checkpoints(tampered_pos25), "Byte-Flip Position 25 (Key): Stored byte corruption detected")
assert_eq(liquid_reconstruct(tampered_pos25, ground_truth_payload), "ACCESS_DENIED: Layer checkpoint mismatch or tamper detected", "Byte-Flip Position 25: Access denied on corrupted byte")

# Test 3: Flip byte at index 50 (inside numeric balance value: e.g. 4500000)
let tampered_pos50 = liquid_shard_payload(ground_truth_payload)
tampered_pos50["payload_mass"] = mutate_byte_at(tampered_pos50["payload_mass"], 50)
assert_false(liquid_verify_checkpoints(tampered_pos50), "Byte-Flip Position 50 (Value): Stored balance tampering caught")
assert_eq(liquid_reconstruct(tampered_pos50, ground_truth_payload), "ACCESS_DENIED: Layer checkpoint mismatch or tamper detected", "Byte-Flip Position 50: Access denied on corrupted balance")

# Test 4: Flip byte at index 75 (inside status string)
let tampered_pos75 = liquid_shard_payload(ground_truth_payload)
tampered_pos75["payload_mass"] = mutate_byte_at(tampered_pos75["payload_mass"], 75)
assert_false(liquid_verify_checkpoints(tampered_pos75), "Byte-Flip Position 75 (Status): Stored status tampering caught")

# Test 5: Flip last byte (trailing delimiter)
let mass_len = len(original_shard["payload_mass"])
let last_idx = mass_len - 1
let tampered_pos_last = liquid_shard_payload(ground_truth_payload)
tampered_pos_last["payload_mass"] = mutate_byte_at(tampered_pos_last["payload_mass"], last_idx)
assert_false(liquid_verify_checkpoints(tampered_pos_last), "Byte-Flip Position Last (Delimiter): Stored tail corruption detected")

# ------------------------------------------------------------------------------
# SELF-HEALING FROM WAL CHECK
# ------------------------------------------------------------------------------
let recovered_shard = original_shard
assert_true(liquid_verify_checkpoints(recovered_shard), "Self-Healing: Pristine WAL checkpoint verified 100%")
assert_eq(liquid_reconstruct(recovered_shard, ground_truth_payload), ground_truth_payload, "Self-Healing: Exact original balance ₹45,00,000 restored")

test_end_suite()
