{
  "name": "aayu",
  "displayName": "AAYU",
  "description": "AAYU Programming Language Support for VS Code",
  "version": "1.1.0",
  "publisher": "AyushKaushik",
  "engines": {
    "vscode": "^1.125.0"
  },
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AAYU-Lang/vscode-aayu.git"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aayu",
        "aliases": [
          "AAYU",
          "aayu"
        ],
        "extensions": [
          ".aayu"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aayu",
        "scopeName": "source.aayu",
        "path": "./syntaxes/aayu.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aayu",
        "path": "./snippets/aayu.code-snippets"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
