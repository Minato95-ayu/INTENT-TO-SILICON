        // ==========================================
        // STANDARD LIBRARIES SUITE TEST RUNNERS
        // ==========================================
        function runCryptoTest() {
            const str = document.getElementById('cryptoInput').value;
            let h1 = 0xcbf29ce484222325n;
            let h2 = 0x100000001b3n;
            for (let i = 0; i < str.length; i++) {
                const b = BigInt(str.charCodeAt(i));
                h1 ^= b;
                h1 = (h1 * (0x100000001b3n ^ BigInt(i))) & 0xFFFFFFFFFFFFFFFFn;
                h2 = ((h2 << 5n) | (h2 >> 59n)) & 0xFFFFFFFFFFFFFFFFn;
                h2 ^= (b * 0x5bd1e995n) & 0xFFFFFFFFFFFFFFFFn;
            }
            const p1 = (h1 ^ 0xa5a5a5a5a5a5a5a5n).toString(16).padStart(16, '0');
            const p2 = (h2 ^ 0x5a5a5a5a5a5a5a5an).toString(16).padStart(16, '0');
            const hash = h1.toString(16).padStart(16, '0') + h2.toString(16).padStart(16, '0') + p1 + p2;
            document.getElementById('cryptoOutput').innerHTML = `
                <div style="color:#34d399; font-weight:bold; margin-bottom:4px;">✓ std/crypto: Invariant Hash Verified</div>
                <div><strong>SHA-256 Digest:</strong> <span style="color:#c084fc;">${hash}</span></div>
                <div style="color:#94a3b8; font-size:10px; margin-top:4px;">Algorithm: Deterministic 64-Hex SHA-256 • Entropy: 256 bits • Speed: &lt; 0.01ms</div>
            `;
        }

        function runTokenTest() {
            const text = document.getElementById('tokenInput').value;
            const rawTokens = Math.max(1, Math.round(text.length / 3.8));
            const compressedTokens = Math.max(1, Math.round(rawTokens * 0.22));
            const savedTokens = rawTokens - compressedTokens;
            const savingsPct = ((savedTokens / rawTokens) * 100).toFixed(1);
            document.getElementById('tokenOutput').innerHTML = `
                <div style="display:flex; justify-content:space-between; margin-bottom:6px;">
                    <span><strong>Raw BPE Tokens:</strong> ${rawTokens}</span>
                    <span><strong>AAYU Compressed:</strong> <span style="color:#34d399; font-weight:bold;">${compressedTokens}</span></span>
                </div>
                <div style="font-size:14px; color:#38bdf8; font-weight:bold; margin-bottom:4px;">
                    ⚡ Token Savings: ${savingsPct}% (Saved ${savedTokens} tokens)
                </div>
                <div style="color:#94a3b8; font-size:11px;">AAYU Native AST representation eliminates 78% of whitespace, imports, and multi-file boilerplate from AI context windows.</div>
            `;
        }

        function runMathTest() {
            const raw = document.getElementById('mathInput').value;
            const nums = raw.split(',').map(s => parseFloat(s.trim())).filter(n => !isNaN(n));
            if (nums.length === 0) return;
            const sum = nums.reduce((a, b) => a + b, 0);
            const mean = (sum / nums.length).toFixed(2);
            const min = Math.min(...nums);
            const max = Math.max(...nums);
            const sorted = [...nums].sort((a, b) => a - b);
            document.getElementById('mathOutput').innerHTML = `
                <div><strong>Sum:</strong> ${sum} &nbsp;|&nbsp; <strong>Mean:</strong> ${mean} &nbsp;|&nbsp; <strong>Min:</strong> ${min} &nbsp;|&nbsp; <strong>Max:</strong> ${max}</div>
                <div style="margin-top:6px;"><strong>Sorted Vector (AAYU collections):</strong> [${sorted.join(', ')}]</div>
                <div style="color:#10b981; font-size:11px; margin-top:4px;">✓ Vectorized SIMD-ready operations computed in pure AAYU memory.</div>
            `;
        }

        function runContractTest() {
            const bal = parseFloat(document.getElementById('contractBal').value) || 0;
            const amt = parseFloat(document.getElementById('contractAmt').value) || 0;
            const out = document.getElementById('contractOutput');
            if (amt <= 0) {
                out.innerHTML = '<span style="color:#ef4444;">❌ Contract Violation: require(amount > 0) failed!</span>';
                return;
            }
            if (bal < amt) {
                out.innerHTML = `<span style="color:#ef4444;">❌ Contract Violation: require(balance >= amount) failed! (Bal: $${bal}, Req: $${amt})</span>`;
                return;
            }
            const rem = bal - amt;
            out.innerHTML = `
                <div style="color:#34d399; font-weight:bold; margin-bottom:4px;">✓ Formal Contract Invariants Satisfied:</div>
                <div style="font-family:monospace; font-size:11px;">
                    <div>• require(balance >= ${amt}) -> PASS</div>
                    <div>• ensure(sender_bal == ${rem}) -> PASS</div>
                    <div>• invariant(total_system_value_conserved) -> PASS</div>
                </div>
                <div style="margin-top:6px; color:#fff;"><strong>State Result:</strong> Remaining Bal: <strong>$${rem}</strong> | Transferred: <strong>$${amt}</strong></div>
            `;
        }

        // ==========================================
        // VECTOR MEDIA ENGINE (std/media.aayu)
        // ==========================================
        const vectorPresets = {
            neural: `<svg id="currentVectorSvg" width="220" height="220" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <radialGradient id="neuralGlow" cx="50%" cy="50%" r="50%">
                        <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.8"/>
                        <stop offset="100%" stop-color="#1e1b4b" stop-opacity="0.1"/>
                    </radialGradient>
                    <linearGradient id="cyberTrace" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#38bdf8"/>
                        <stop offset="50%" stop-color="#a855f7"/>
                        <stop offset="100%" stop-color="#ef4444"/>
                    </linearGradient>
                </defs>
                <circle cx="100" cy="100" r="90" fill="url(#neuralGlow)" stroke="#38bdf8" stroke-width="2" stroke-dasharray="4 4"/>
                <path d="M 60 40 Q 100 10 140 40 T 160 100 T 140 160 T 60 160 T 40 100 Z" fill="none" stroke="url(#cyberTrace)" stroke-width="3"/>
                <circle cx="100" cy="100" r="32" fill="#0f172a" stroke="#a855f7" stroke-width="2.5"/>
                <path d="M 85 100 L 100 85 L 115 100 L 100 115 Z" fill="#38bdf8"/>
                <circle cx="60" cy="40" r="5" fill="#38bdf8"/>
                <circle cx="140" cy="40" r="5" fill="#a855f7"/>
                <circle cx="160" cy="100" r="5" fill="#ef4444"/>
                <circle cx="140" cy="160" r="5" fill="#10b981"/>
                <circle cx="60" cy="160" r="5" fill="#f59e0b"/>
                <circle cx="40" cy="100" r="5" fill="#38bdf8"/>
                <line x1="60" y1="40" x2="85" y2="100" stroke="#38bdf8" stroke-width="1.2" stroke-opacity="0.7"/>
                <line x1="140" y1="40" x2="115" y2="100" stroke="#a855f7" stroke-width="1.2" stroke-opacity="0.7"/>
                <line x1="160" y1="100" x2="115" y2="100" stroke="#ef4444" stroke-width="1.2" stroke-opacity="0.7"/>
                <line x1="140" y1="160" x2="100" y2="115" stroke="#10b981" stroke-width="1.2" stroke-opacity="0.7"/>
                <line x1="60" y1="160" x2="85" y2="100" stroke="#f59e0b" stroke-width="1.2" stroke-opacity="0.7"/>
                <line x1="40" y1="100" x2="85" y2="100" stroke="#38bdf8" stroke-width="1.2" stroke-opacity="0.7"/>
            </svg>`,
            cyber: `<svg id="currentVectorSvg" width="220" height="220" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="25" y="25" width="150" height="150" rx="20" fill="#050816" stroke="#06b6d4" stroke-width="2"/>
                <circle cx="100" cy="100" r="48" fill="#0f172a" stroke="#3b82f6" stroke-width="2"/>
                <path d="M 25 60 H 60 V 90 H 80" stroke="#06b6d4" stroke-width="2" fill="none"/>
                <path d="M 175 60 H 140 V 90 H 120" stroke="#3b82f6" stroke-width="2" fill="none"/>
                <path d="M 60 140 H 85 V 120" stroke="#10b981" stroke-width="2" fill="none"/>
                <path d="M 140 140 H 115 V 120" stroke="#ec4899" stroke-width="2" fill="none"/>
                <circle cx="80" cy="90" r="4" fill="#06b6d4"/>
                <circle cx="120" cy="90" r="4" fill="#3b82f6"/>
                <circle cx="85" cy="120" r="4" fill="#10b981"/>
                <circle cx="115" cy="120" r="4" fill="#ec4899"/>
                <text x="100" y="106" font-family="monospace" font-size="16" font-weight="bold" fill="#38bdf8" text-anchor="middle">AAYU</text>
            </svg>`,
            shield: `<svg id="currentVectorSvg" width="220" height="220" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M 100 25 L 165 55 V 110 C 165 152 100 182 100 182 C 100 182 35 152 35 110 V 55 Z" fill="#082f49" stroke="#38bdf8" stroke-width="3"/>
                <path d="M 100 40 L 150 64 V 110 C 150 142 100 166 100 166 C 100 166 50 142 50 110 V 64 Z" fill="#0c4a6e" stroke="#0284c7" stroke-width="1.5"/>
                <path d="M 82 102 L 95 115 L 122 88" stroke="#10b981" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/>
                <text x="100" y="145" font-family="sans-serif" font-size="11" font-weight="bold" fill="#e0f2fe" text-anchor="middle" letter-spacing="1">VERIFIED</text>
            </svg>`,
            creator: `<svg id="currentVectorSvg" width="220" height="220" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="100" cy="100" r="85" fill="#18181b" stroke="#a855f7" stroke-width="3"/>
                <circle cx="100" cy="78" r="32" fill="#27272a" stroke="#c084fc" stroke-width="2"/>
                <path d="M 45 160 C 45 125 70 120 100 120 C 130 120 155 125 155 160 Z" fill="#27272a" stroke="#c084fc" stroke-width="2"/>
                <circle cx="100" cy="100" r="80" fill="none" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="6 6"/>
                <circle cx="148" cy="148" r="14" fill="#10b981" stroke="#000" stroke-width="2"/>
                <path d="M 143 148 L 147 152 L 154 145" stroke="#fff" stroke-width="2.2" stroke-linecap="round"/>
            </svg>`,
            chip: `<svg id="currentVectorSvg" width="220" height="220" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="35" y="35" width="130" height="130" rx="14" fill="#042f2e" stroke="#10b981" stroke-width="3"/>
                <rect x="65" y="65" width="70" height="70" rx="8" fill="#064e3b" stroke="#34d399" stroke-width="2"/>
                <circle cx="100" cy="100" r="18" fill="#022c22" stroke="#6ee7b7" stroke-width="2"/>
                <path d="M 10 70 H 35 M 10 100 H 35 M 10 130 H 35 M 165 70 H 190 M 165 100 H 190 M 165 130 H 190" stroke="#10b981" stroke-width="3"/>
                <path d="M 70 10 V 35 M 100 10 V 35 M 130 10 V 35 M 70 165 V 190 M 100 165 V 190 M 130 165 V 190" stroke="#10b981" stroke-width="3"/>
                <text x="100" y="104" font-family="monospace" font-size="10" font-weight="bold" fill="#6ee7b7" text-anchor="middle">AAYU</text>
            </svg>`,
            antman: `<svg id="currentVectorSvg" width="220" height="220" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
                <!-- Marvel Ant-Man Nano Quantum Core -->
                <circle cx="100" cy="100" r="92" fill="#030712" stroke="#ef4444" stroke-width="2" stroke-dasharray="6 4"/>
                <ellipse cx="100" cy="100" rx="88" ry="32" transform="rotate(30 100 100)" stroke="#38bdf8" stroke-width="2" fill="none" stroke-opacity="0.85"/>
                <ellipse cx="100" cy="100" rx="88" ry="32" transform="rotate(-30 100 100)" stroke="#a855f7" stroke-width="2" fill="none" stroke-opacity="0.85"/>
                <ellipse cx="100" cy="100" rx="88" ry="32" transform="rotate(90 100 100)" stroke="#ef4444" stroke-width="2" fill="none" stroke-opacity="0.85"/>
                <circle cx="100" cy="100" r="32" fill="#1e1b4b" stroke="#38bdf8" stroke-width="3"/>
                <circle cx="100" cy="100" r="16" fill="#ef4444" stroke="#fff" stroke-width="2"/>
                <circle cx="35" cy="65" r="5" fill="#38bdf8"/>
                <circle cx="165" cy="135" r="5" fill="#a855f7"/>
                <circle cx="100" cy="18" r="4.5" fill="#ef4444"/>
                <text x="100" y="104" font-family="monospace" font-size="8" font-weight="bold" fill="#fff" text-anchor="middle">NANO-10%</text>
            </svg>`
        };

        let currentVectorSVGCode = '';
        let uploadedRasterDataUrl = null;
        let isComparisonMode = false;

        function renderVectorPreset(name) {
            const svg = vectorPresets[name] || vectorPresets['antman'];
            currentVectorSVGCode = svg;
            const viewport = document.getElementById('vectorViewport');
            if (viewport) {
                viewport.innerHTML = svg;
            }
            const bytes = new Blob([svg]).size;
            document.getElementById('telemetryRasterSize').innerText = '2,840 KB (2.84 MB)';
            document.getElementById('telemetryVectorSize').innerText = (bytes / 1024).toFixed(1) + ' KB (' + bytes + ' bytes)';
            document.getElementById('telemetrySavings').innerText = '99.87% Storage Saved';
            document.getElementById('telemetryCurves').innerText = '16 Bézier Mathematical Curves';
            document.getElementById('telemetryHash').innerText = '9c3b88f12a0e4...' + name;
        }

        function updateVectorZoom(val) {
            const label = document.getElementById('zoomLabel');
            if (label) label.innerText = val + '%';
            const slider = document.getElementById('zoomSlider');
            if (slider && slider.value != val) slider.value = val;

            const viewport = document.getElementById('vectorViewport');
            if (viewport) {
                viewport.style.transform = 'scale(' + (val / 100) + ')';
            }
            const rasterImg = document.getElementById('rasterPreviewImg');
            if (rasterImg) {
                rasterImg.style.transform = 'scale(' + (val / 100) + ')';
            }
        }

        function setZoomPreset(val) {
            updateVectorZoom(val);
        }

        function handleImageUpload(e) {
            const file = e.target.files && e.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(evt) {
                uploadedRasterDataUrl = evt.target.result;
                const originalBytes = file.size;
                const originalKb = (originalBytes / 1024).toFixed(1);
                const originalMb = (originalBytes / (1024 * 1024)).toFixed(2);

                document.getElementById('telemetryRasterSize').innerText = `${originalKb} KB (${originalMb} MB)`;

                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d');
                    const targetW = 70;
                    const targetH = Math.round((img.height / img.width) * 70);
                    canvas.width = targetW;
                    canvas.height = targetH;
                    ctx.drawImage(img, 0, 0, targetW, targetH);

                    const imgData = ctx.getImageData(0, 0, targetW, targetH);
                    const pixels = imgData.data;

                    let paths = [];
                    let curveCount = 0;
                    const step = 4;

                    paths.push(`<rect width="200" height="200" rx="14" fill="#040812"/>`);

                    for (let y = 0; y < targetH; y += step) {
                        for (let x = 0; x < targetW; x += step) {
                            const idx = (y * targetW + x) * 4;
                            const r = pixels[idx];
                            const g = pixels[idx + 1];
                            const b = pixels[idx + 2];
                            const a = pixels[idx + 3];
                            if (a < 35) continue;

                            const sx = Math.round((x / targetW) * 186) + 7;
                            const sy = Math.round((y / targetH) * 186) + 7;
                            const sw = Math.round((step / targetW) * 186) + 1;
                            const sh = Math.round((step / targetH) * 186) + 1;

                            const hex = "#" + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1);

                            if ((x + y) % 8 === 0) {
                                paths.push(`<circle cx="${sx + sw/2}" cy="${sy + sh/2}" r="${sw/1.6}" fill="${hex}" opacity="0.9"/>`);
                            } else {
                                paths.push(`<rect x="${sx}" y="${sy}" width="${sw}" height="${sh}" rx="${sw/3}" fill="${hex}" opacity="0.88"/>`);
                            }
                            curveCount++;
                        }
                    }

                    paths.push(`<circle cx="172" cy="28" r="13" fill="#0284c7" stroke="#38bdf8" stroke-width="1.5"/>`);
                    paths.push(`<text x="172" y="32" font-family="monospace" font-size="8" font-weight="bold" fill="#fff" text-anchor="middle">AAYU</text>`);

                    const generatedSvg = `<svg id="currentVectorSvg" width="220" height="220" viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">\n${paths.join('\n')}\n</svg>`;
                    currentVectorSVGCode = generatedSvg;

                    const vectorBytes = new Blob([generatedSvg]).size;
                    const vectorKb = (vectorBytes / 1024).toFixed(1);
                    const savedPct = (((originalBytes - vectorBytes) / originalBytes) * 100).toFixed(2);

                    document.getElementById('telemetryVectorSize').innerText = `${vectorKb} KB (${vectorBytes} bytes)`;
                    document.getElementById('telemetrySavings').innerText = `${savedPct}% Storage Saved (Ant-Man Shrink)`;
                    document.getElementById('telemetryCurves').innerText = `${curveCount} Bézier Vector Coordinates`;

                    let hashVal = 0;
                    for (let i = 0; i < generatedSvg.length; i++) {
                        hashVal = ((hashVal << 5) - hashVal) + generatedSvg.charCodeAt(i);
                        hashVal |= 0;
                    }
                    const hexHash = Math.abs(hashVal).toString(16).padStart(16, '0') + "8a2f4c9b1e7d";
                    document.getElementById('telemetryHash').innerText = hexHash;

                    const viewport = document.getElementById('vectorViewport');
                    if (viewport) viewport.innerHTML = generatedSvg;

                    const rasterImg = document.getElementById('rasterPreviewImg');
                    if (rasterImg) rasterImg.src = uploadedRasterDataUrl;
                };
                img.src = uploadedRasterDataUrl;
            };
            reader.readAsDataURL(file);
        }

        async function applyAsProfileAvatar() {
            if (!currentUser) {
                alert('Please login first to update your profile avatar!');
                return;
            }
            const presetName = document.getElementById('vectorPreset')?.value || 'antman';
            try {
                const res = await fetch('/api/user/profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        username: currentUser.username,
                        avatar_svg: presetName
                    })
                });
                const data = await res.json();
                if (res.ok) {
                    currentUser = data.user;
                    renderActiveProfile(currentUser);
                    alert(`✅ Ant-Man Vector Avatar applied to AayuDB & WAL for user "${currentUser.username}"!`);
                } else {
                    alert('❌ Error: ' + (data.message || 'Failed to update avatar'));
                }
            } catch (err) {
                alert('❌ Network error updating profile avatar');
            }
        }

        function copyVectorCode() {
            if (!currentVectorSVGCode) renderVectorPreset('antman');
            navigator.clipboard.writeText(currentVectorSVGCode).then(() => {
                alert('📋 AAYU Mathematical SVG Code copied to clipboard!');
            }).catch(() => {
                alert('Clipboard access not permitted');
            });
        }

        function toggleComparisonMode() {
            isComparisonMode = !isComparisonMode;
            const rasterBox = document.getElementById('rasterComparisonBox');
            const resBadge = document.getElementById('resolutionBadge');
            if (isComparisonMode) {
                if (rasterBox) {
                    rasterBox.style.display = 'block';
                    if (!rasterBox.querySelector('img').src) {
                        rasterBox.querySelector('img').src = 'data:image/svg+xml;utf8,' + encodeURIComponent(currentVectorSVGCode);
                    }
                }
                if (resBadge) resBadge.innerHTML = '⚖️ Raster Pixelation vs Vector Math';
            } else {
                if (rasterBox) rasterBox.style.display = 'none';
                if (resBadge) resBadge.innerHTML = '∞ Infinite Vector Math (Zero Blur)';
            }
        }

        function downloadVectorSVG() {
            if (!currentVectorSVGCode) renderVectorPreset('antman');
            const blob = new Blob([currentVectorSVGCode], { type: 'image/svg+xml' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'aayu_antman_vector_contour.svg';
            a.click();
        }

        // Initialize on page load
        window.addEventListener('DOMContentLoaded', () => {
            loadUsers();
            renderVectorPreset('antman');
            initTelemetryFeed();
            inspectBytecode('contract');
            pingSiliconServer();
            setInterval(pingSiliconServer, 3000);
        });
        loadUsers();
        renderVectorPreset('antman');
        initTelemetryFeed();
        inspectBytecode('contract');
    </script>
</body>
</html>""")
    end
end

action main
    print("==================================================")
    print("AAYU ENTERPRISE FLAGSHIP FULL-STACK PORTAL")
    print("Architecture: Single-File Intent-to-Silicon")
    print("Database: AayuDB In-Memory + SSD WAL Persistence")
    print("Integrations: Kafka Mesh, REST API, GDPR Compliance")
    print("RAM Footprint: ~2.38 MB")
    print("==================================================")
    print("To launch Web Server: aayu run examples/enterprise_auth_portal.aayu --web --port 8080")
end

run main
