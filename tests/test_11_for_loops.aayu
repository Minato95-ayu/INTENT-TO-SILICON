# Test 11: For Loops Iteration & Aggregations
let items = [10, 20, 30, 40]
let sum = 0

let i = 0
let n = len(items)

while i < n
    sum = sum + items[i]
    i = i + 1
end

print("For Loop Sum (expected 100):")
print(sum)

if sum == 100
    print("PASS: For loop aggregated successfully")
else
    print("FAIL: Incorrect sum")
end
