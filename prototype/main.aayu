# CRMApp - Generated by AAYU Intent-to-Silicon
use http.
use db.
use auth.

entity Customer.
    text name.
    text created_at.
end.

entity Lead.
    text name.
    text created_at.
end.

entity Deal.
    text name.
    text created_at.
    number employee_id.
end.

entity Employee.
    text name.
    text created_at.
end.

entity Invoice.
    text name.
    text created_at.
end.

entity Quote.
    text name.
    text created_at.
end.

entity EmailTemplate.
    text name.
    text created_at.
end.

entity Task.
    text name.
    text created_at.
end.

entity Board.
    text name.
    text created_at.
end.

entity User.
    text name.
    text created_at.
end.

entity Role.
    text name.
    text created_at.
end.

entity Permission.
    text name.
    text created_at.
end.

entity UserRole.
    text name.
    text created_at.
    number user_id.
    number role_id.
end.

task handle_login with req.
    return render "login.html".
end.

route "/login" to handle_login.

task handle_dashboard with req.
    return render "dashboard.html".
end.

route "/dashboard" to handle_dashboard.

task handle_customers with req.
    return render "customers.html".
end.

route "/customers" to handle_customers.

task handle_leads with req.
    return render "leads.html".
end.

route "/leads" to handle_leads.

serve on 8080.