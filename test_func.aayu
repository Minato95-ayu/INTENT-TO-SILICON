action is_alpha(c)
    if c >= "a"
        if c <= "z"
            return 1
        end
    end
    if c >= "A"
        if c <= "Z"
            return 1
        end
    end
    if c == "_"
        return 1
    end
    return 0
end

action main_logic()
    let test_str = "H"
    let result = is_alpha(test_str)
    
    if result == 1
        print("It is a valid alphabet/underscore character!")
    end
    
    if is_alpha("9") == 1
        print("Wait, 9 shouldn't be alpha.")
    end
    
    print("Done checking!")
end

main_logic()
