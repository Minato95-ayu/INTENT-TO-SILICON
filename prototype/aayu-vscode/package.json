{
  "name": "aayu",
  "displayName": "Aayu Language",
  "description": "Language support for Aayu",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:aayu"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "aayu",
        "aliases": ["Aayu", "aayu"],
        "extensions": [".aayu"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aayu",
        "scopeName": "source.aayu",
        "path": "./syntaxes/aayu.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  }
}
