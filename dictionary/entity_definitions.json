{
  "student": {
    "fields": [
      {"name": "id", "type": "UUID", "primary_key": true},
      {"name": "name", "type": "VARCHAR(255)", "required": true},
      {"name": "email", "type": "VARCHAR(255)", "unique": true},
      {"name": "phone", "type": "VARCHAR(20)", "unique": true},
      {"name": "created_at", "type": "TIMESTAMP", "default": "CURRENT_TIMESTAMP"}
    ]
  },
  "library_booking": {
    "fields": [
      {"name": "id", "type": "UUID", "primary_key": true},
      {"name": "student_id", "type": "UUID", "foreign_key": "student.id", "required": true},
      {"name": "seat_number", "type": "VARCHAR(10)"},
      {"name": "booking_date", "type": "DATE", "required": true},
      {"name": "status", "type": "VARCHAR(50)", "default": "'ACTIVE'"}
    ]
  },
  "hostel_room": {
    "fields": [
      {"name": "id", "type": "UUID", "primary_key": true},
      {"name": "room_number", "type": "VARCHAR(10)", "unique": true},
      {"name": "capacity", "type": "INT", "default": "2"},
      {"name": "is_available", "type": "BOOLEAN", "default": "TRUE"}
    ]
  },
  "job_application": {
    "fields": [
      {"name": "id", "type": "UUID", "primary_key": true},
      {"name": "student_id", "type": "UUID", "foreign_key": "student.id", "required": true},
      {"name": "company_name", "type": "VARCHAR(255)"},
      {"name": "role", "type": "VARCHAR(100)"},
      {"name": "resume_url", "type": "VARCHAR(255)"},
      {"name": "status", "type": "VARCHAR(50)", "default": "'APPLIED'"}
    ]
  },
  "tutor_session": {
    "fields": [
      {"name": "id", "type": "UUID", "primary_key": true},
      {"name": "tutor_name", "type": "VARCHAR(255)", "required": true},
      {"name": "student_id", "type": "UUID", "foreign_key": "student.id", "required": true},
      {"name": "subject", "type": "VARCHAR(100)", "required": true},
      {"name": "scheduled_at", "type": "TIMESTAMP", "required": true}
    ]
  },
  "payment_transaction": {
    "fields": [
      {"name": "id", "type": "UUID", "primary_key": true},
      {"name": "student_id", "type": "UUID", "foreign_key": "student.id", "required": true},
      {"name": "amount", "type": "DECIMAL(10, 2)", "required": true},
      {"name": "currency", "type": "VARCHAR(3)", "default": "'INR'"},
      {"name": "method", "type": "VARCHAR(50)", "default": "'UPI'"},
      {"name": "status", "type": "VARCHAR(50)", "default": "'PENDING'"}
    ]
  },
  "security_audit_log": {
    "fields": [
      {"name": "id", "type": "UUID", "primary_key": true},
      {"name": "event_type", "type": "VARCHAR(100)"},
      {"name": "user_id", "type": "UUID"},
      {"name": "ip_address", "type": "VARCHAR(45)"},
      {"name": "created_at", "type": "TIMESTAMP", "default": "CURRENT_TIMESTAMP"}
    ]
  }
}
