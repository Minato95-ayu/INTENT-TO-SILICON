# ==============================================================================
# AAYU Standard Library: Database Record Store (std/db.aayu)
# 100% Pure AAYU - Record Manipulation & Query Filter Helpers
# ==============================================================================

action db_create_record(id, name, value)
    return { "id": id, "name": name, "value": value }
end

action db_filter_records(records, field, target_val)
    let results = []
    let i = 0
    let total = len(records)
    while i < total
        let row = records[i]
        if row[field] == target_val
            results = results + [row]
        end
        i = i + 1
    end
    return results
end

action db_find_by_id(records, target_id)
    let i = 0
    let total = len(records)
    while i < total
        let row = records[i]
        if row["id"] == target_id
            return row
        end
        i = i + 1
    end
    return {}
end

action db_count_records(records)
    return len(records)
end
