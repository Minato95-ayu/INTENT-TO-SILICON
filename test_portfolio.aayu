app SafePortfolio

Page HomePage
    Column width="100vw" height="100vh" margin="0" overflow="hidden" backgroundColor="#06060d"

        Row width="100%" padding="16px 60px" justifyContent="space-between" alignItems="center" borderBottom="1px solid #15151f" backgroundColor="#08080f"
            Row alignItems="center" gap="12px"
                Container width="36px" height="36px" backgroundColor="#a78bfa" borderRadius="10px" alignItems="center" justifyContent="center"
                    Text "A" fontSize="18px" fontWeight="900" color="#06060d"
                end
                Text "ayush.dev" fontSize="17px" fontWeight="800" color="#ffffff" letterSpacing="1px"
            end
            Row alignItems="center" gap="34px"
                Text "About" fontSize="14px" color="#9ca3af" onClick=scroll_about cursor="pointer"
                Text "Skills" fontSize="14px" color="#9ca3af" onClick=scroll_skills cursor="pointer"
                Text "Work" fontSize="14px" color="#9ca3af" onClick=scroll_work cursor="pointer"
                Text "Contact" fontSize="14px" color="#9ca3af" onClick=scroll_contact cursor="pointer"
            end
            Button "Hire me" backgroundColor="#a78bfa" borderRadius="10px" padding="10px 22px" fontSize="14px" fontWeight="bold" color="#06060d" onClick=hire_me
        end

        Column width="100%" height="100%" overflowY="auto" gap="0"

            Container width="100%" padding="100px 60px 80px 60px" alignItems="center" justifyContent="center"
                Column alignItems="center" gap="28px" maxWidth="920px"
                    Card backgroundColor="#131320" borderRadius="999px" padding="8px 18px" border="1px solid #23233a"
                        Row alignItems="center" gap="10px"
                            Container width="8px" height="8px" backgroundColor="#34d399" borderRadius="999px"
                            end
                            Text "Available for freelance and full-time" fontSize="12px" color="#a5f3fc"
                        end
                    end
                    Column alignItems="center" gap="18px"
                        Text "AYUSH KUMAR - FULL STACK DEV" fontSize="12px" fontWeight="bold" color="#a78bfa" letterSpacing="6px"
                        Text "I build fast software that ships." fontSize="56px" fontWeight="900" color="#ffffff" textAlign="center"
                        Text "Full-stack developer, systems tinkerer, and creator of AAYU." fontSize="17px" color="#9ca3af" textAlign="center" maxWidth="660px"
                    end
                    Row gap="14px" margin="16px 0 0 0"
                        Button "See my work" backgroundColor="#a78bfa" borderRadius="12px" padding="16px 32px" fontSize="15px" fontWeight="bold" color="#06060d" onClick=view_work
                        Button "Download CV" backgroundColor="#131320" borderRadius="12px" padding="16px 32px" border="1px solid #23233a" fontSize="15px" fontWeight="bold" color="#e5e7eb" onClick=download_cv
                    end
                    Row gap="60px" margin="40px 0 0 0"
                        Column alignItems="center" gap="4px"
                            Text "5+" fontSize="30px" fontWeight="900" color="#a78bfa"
                            Text "YEARS" fontSize="11px" color="#6b7280" letterSpacing="2px"
                        end
                        Container width="1px" height="40px" backgroundColor="#23233a"
                        end
                        Column alignItems="center" gap="4px"
                            Text "20+" fontSize="30px" fontWeight="900" color="#22d3ee"
                            Text "PROJECTS" fontSize="11px" color="#6b7280" letterSpacing="2px"
                        end
                        Container width="1px" height="40px" backgroundColor="#23233a"
                        end
                        Column alignItems="center" gap="4px"
                            Text "340" fontSize="30px" fontWeight="900" color="#34d399"
                            Text "STARS" fontSize="11px" color="#6b7280" letterSpacing="2px"
                        end
                    end
                end
            end

            Column padding="80px 60px" gap="30px" width="100%"
                Row gap="14px" alignItems="center"
                    Container width="24px" height="2px" backgroundColor="#a78bfa"
                    end
                    Text "01 / ABOUT" fontSize="12px" fontWeight="bold" color="#a78bfa" letterSpacing="5px"
                end
                Text "Code, coffee, ship." fontSize="44px" fontWeight="900" color="#ffffff"
                Text "I started with Python at 15 and moved into C and Rust when I wanted to understand how things work under the hood." fontSize="16px" color="#9ca3af" maxWidth="820px"
            end

            Column padding="80px 60px" gap="30px" width="100%" backgroundColor="#08080f"
                Row gap="14px" alignItems="center"
                    Container width="24px" height="2px" backgroundColor="#22d3ee"
                    end
                    Text "02 / SKILLS" fontSize="12px" fontWeight="bold" color="#22d3ee" letterSpacing="5px"
                end
                Text "Tools of the trade" fontSize="44px" fontWeight="900" color="#ffffff"
                Grid gridTemplateColumns="repeat(auto-fill, minmax(260px, 1fr))" gap="18px" width="100%"
                    Card backgroundColor="#0f0f1a" borderRadius="18px" padding="28px" border="1px solid #1a1a2e" display="flex" flexDirection="column" gap="16px"
                        Icon name="code" color="#a78bfa" fontSize="24px"
                        Text "Languages" fontSize="18px" fontWeight="bold" color="#ffffff"
                        Text "Python, C, Rust, TypeScript" fontSize="13px" color="#9ca3af"
                    end
                    Card backgroundColor="#0f0f1a" borderRadius="18px" padding="28px" border="1px solid #1a1a2e" display="flex" flexDirection="column" gap="16px"
                        Icon name="layer-group" color="#22d3ee" fontSize="24px"
                        Text "Frontend" fontSize="18px" fontWeight="bold" color="#ffffff"
                        Text "React, Svelte, Tailwind" fontSize="13px" color="#9ca3af"
                    end
                    Card backgroundColor="#0f0f1a" borderRadius="18px" padding="28px" border="1px solid #1a1a2e" display="flex" flexDirection="column" gap="16px"
                        Icon name="server" color="#34d399" fontSize="24px"
                        Text "Backend" fontSize="18px" fontWeight="bold" color="#ffffff"
                        Text "FastAPI, Postgres, Redis" fontSize="13px" color="#9ca3af"
                    end
                    Card backgroundColor="#0f0f1a" borderRadius="18px" padding="28px" border="1px solid #1a1a2e" display="flex" flexDirection="column" gap="16px"
                        Icon name="bolt" color="#facc15" fontSize="24px"
                        Text "Systems" fontSize="18px" fontWeight="bold" color="#ffffff"
                        Text "Compilers, VMs, WASM" fontSize="13px" color="#9ca3af"
                    end
                end
            end

            Column padding="80px 60px" gap="30px" width="100%"
                Row gap="14px" alignItems="center"
                    Container width="24px" height="2px" backgroundColor="#34d399"
                    end
                    Text "03 / WORK" fontSize="12px" fontWeight="bold" color="#34d399" letterSpacing="5px"
                end
                Text "Selected projects" fontSize="44px" fontWeight="900" color="#ffffff"
                Grid gridTemplateColumns="repeat(auto-fill, minmax(340px, 1fr))" gap="20px" width="100%"
                    Card backgroundColor="#0f0f1a" borderRadius="18px" padding="28px" border="1px solid #1a1a2e" display="flex" flexDirection="column" gap="16px"
                        Icon name="bolt" color="#facc15" fontSize="22px"
                        Text "AAYU Language" fontSize="20px" fontWeight="bold" color="#ffffff"
                        Text "A small language with built-in UI, routes, data and native compilation." fontSize="14px" color="#9ca3af"
                    end
                    Card backgroundColor="#0f0f1a" borderRadius="18px" padding="28px" border="1px solid #1a1a2e" display="flex" flexDirection="column" gap="16px"
                        Icon name="server" color="#34d399" fontSize="22px"
                        Text "NovaShop" fontSize="20px" fontWeight="bold" color="#ffffff"
                        Text "Full-stack e-commerce with auth and dashboard. 40k users served." fontSize="14px" color="#9ca3af"
                    end
                    Card backgroundColor="#0f0f1a" borderRadius="18px" padding="28px" border="1px solid #1a1a2e" display="flex" flexDirection="column" gap="16px"
                        Icon name="code" color="#a78bfa" fontSize="22px"
                        Text "Agent Toolkit" fontSize="20px" fontWeight="bold" color="#ffffff"
                        Text "Safe structured access for LLM agents with audit logging." fontSize="14px" color="#9ca3af"
                    end
                    Card backgroundColor="#0f0f1a" borderRadius="18px" padding="28px" border="1px solid #1a1a2e" display="flex" flexDirection="column" gap="16px"
                        Icon name="bolt" color="#22d3ee" fontSize="22px"
                        Text "EdgeCache" fontSize="20px" fontWeight="bold" color="#ffffff"
                        Text "Rust edge cache that cut p95 latency by 42 percent." fontSize="14px" color="#9ca3af"
                    end
                end
            end

            Column padding="80px 60px" gap="30px" width="100%" backgroundColor="#08080f"
                Row gap="14px" alignItems="center"
                    Container width="24px" height="2px" backgroundColor="#f472b6"
                    end
                    Text "04 / EXPERIENCE" fontSize="12px" fontWeight="bold" color="#f472b6" letterSpacing="5px"
                end
                Text "Where I've worked" fontSize="44px" fontWeight="900" color="#ffffff"
                Card backgroundColor="#0f0f1a" borderRadius="16px" padding="26px" border="1px solid #1a1a2e" display="flex" flexDirection="column" gap="10px"
                    Text "Senior Software Engineer" fontSize="20px" fontWeight="bold" color="#ffffff"
                    Text "TechCorp - Remote - 2023 to now" fontSize="14px" color="#22d3ee"
                    Text "Lead the platform team of 6. Shipped a Rust edge cache that cut p95 latency by 42 percent." fontSize="14px" color="#9ca3af"
                end
                Card backgroundColor="#0f0f1a" borderRadius="16px" padding="26px" border="1px solid #1a1a2e" display="flex" flexDirection="column" gap="10px"
                    Text "Full-Stack Developer" fontSize="20px" fontWeight="bold" color="#ffffff"
                    Text "StartupXYZ - Bangalore - 2021 to 2023" fontSize="14px" color="#22d3ee"
                    Text "Built the customer dashboard and billing system. Grew user base from 0 to 40k." fontSize="14px" color="#9ca3af"
                end
            end

            Column padding="80px 60px 100px 60px" gap="30px" width="100%"
                Row gap="14px" alignItems="center"
                    Container width="24px" height="2px" backgroundColor="#a78bfa"
                    end
                    Text "05 / CONTACT" fontSize="12px" fontWeight="bold" color="#a78bfa" letterSpacing="5px"
                end
                Text "Let's build something together." fontSize="44px" fontWeight="900" color="#ffffff"
                Text "Got a project or a crazy idea? My inbox is always open." fontSize="16px" color="#9ca3af"
                Grid gridTemplateColumns="repeat(auto-fill, minmax(240px, 1fr))" gap="16px" width="100%"
                    Card backgroundColor="#0f0f1a" borderRadius="16px" padding="26px" border="1px solid #1a1a2e" display="flex" flexDirection="column" gap="14px"
                        Icon name="mail" color="#a78bfa" fontSize="20px"
                        Text "EMAIL" fontSize="11px" color="#6b7280" letterSpacing="2px" fontWeight="bold"
                        Text "ayush@example.dev" fontSize="14px" fontWeight="bold" color="#ffffff"
                    end
                    Card backgroundColor="#0f0f1a" borderRadius="16px" padding="26px" border="1px solid #1a1a2e" display="flex" flexDirection="column" gap="14px"
                        Icon name="github" color="#a78bfa" fontSize="20px"
                        Text "GITHUB" fontSize="11px" color="#6b7280" letterSpacing="2px" fontWeight="bold"
                        Text "github.com/Minato95-ayu" fontSize="14px" fontWeight="bold" color="#ffffff"
                    end
                    Card backgroundColor="#0f0f1a" borderRadius="16px" padding="26px" border="1px solid #1a1a2e" display="flex" flexDirection="column" gap="14px"
                        Icon name="twitter" color="#a78bfa" fontSize="20px"
                        Text "TWITTER" fontSize="11px" color="#6b7280" letterSpacing="2px" fontWeight="bold"
                        Text "@ayush_dev" fontSize="14px" fontWeight="bold" color="#ffffff"
                    end
                    Card backgroundColor="#0f0f1a" borderRadius="16px" padding="26px" border="1px solid #1a1a2e" display="flex" flexDirection="column" gap="14px"
                        Icon name="linkedin" color="#a78bfa" fontSize="20px"
                        Text "LINKEDIN" fontSize="11px" color="#6b7280" letterSpacing="2px" fontWeight="bold"
                        Text "in/ayush-dev" fontSize="14px" fontWeight="bold" color="#ffffff"
                    end
                end
                Card backgroundColor="#a78bfa" borderRadius="20px" padding="40px" margin="24px 0 0 0" display="flex" flexDirection="column" gap="16px"
                    Text "Ready to start?" fontSize="30px" fontWeight="900" color="#06060d"
                    Text "Drop me a line. I usually reply within a day." fontSize="15px" color="#1f1d2e"
                    Card backgroundColor="#06060d" borderRadius="12px" padding="18px 28px"
                        Text "ayush@example.dev" fontFamily="monospace" fontSize="15px" fontWeight="bold" color="#a78bfa"
                    end
                end
            end

            Container width="100%" padding="30px 60px" backgroundColor="#040408" borderTop="1px solid #15151f"
                Text "2025 Ayush Kumar. Built with AAYU." color="#4b5563" fontSize="13px"
            end
        end
    end
end

run HomePage



