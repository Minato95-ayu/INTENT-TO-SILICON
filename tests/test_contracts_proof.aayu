# ==============================================================================
# PROOF OF AAYU INTENT CONTRACTS (std/contracts)
# ==============================================================================
import "std/contracts.aayu"

action withdraw_money(balance, amount)
    # Pre-condition: amount must be positive and not exceed balance
    let ok1 = require(amount > 0, "amount must be strictly positive")
    let ok2 = require(balance >= amount, "balance must cover requested amount")
    
    if ok1 == 0
        return balance
    end
    if ok2 == 0
        return balance
    end

    let new_balance = balance - amount

    # Post-condition: new_balance must be strictly less than previous balance
    let ok3 = ensure(new_balance < balance, "new balance must decrease after withdrawal")
    return new_balance
end

print("==================================================")
print("     AAYU INTENT CONTRACT VERIFICATION PROOF      ")
print("==================================================")

let initial_bal = 1000
print("Initial Balance: " + initial_bal)

# 1. Valid Withdrawal
let b1 = withdraw_money(initial_bal, 200)
print("After $200 withdrawal: " + b1)

# 2. Invalid Overdraw (Triggers Pre-condition Violation)
print("\nAttempting overdraw of $2000:")
let b2 = withdraw_money(b1, 2000)
print("Balance remains safe: " + b2)

# 3. Type Contract Check
print("\nType Contract Verification:")
let is_int = check_type(b1, "Int", "balance")
print("Balance type Int contract satisfied: " + is_int)
print("==================================================")
