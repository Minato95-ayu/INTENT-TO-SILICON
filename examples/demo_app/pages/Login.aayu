page Login {
    title "Login - Demo App"
    
    state LoginForm {
        username: String = ""
        password: String = ""
        error: String = ""
    }
    
    view {
        container(align: "center", justify: "center", height: "100vh") {
            card(padding: "30px", shadow: "lg") {
                heading(level: 2, text: "Secure Login")
                
                if LoginForm.error != "" {
                    text(color: "red", text: LoginForm.error)
                }
                
                form(id: "loginForm") {
                    input(type: "text", placeholder: "Username", bind: LoginForm.username)
                    input(type: "password", placeholder: "Password", bind: LoginForm.password)
                    
                    button(text: "Login", onClick: handleLogin, color: "primary")
                }
            }
        }
    }
    
    action handleLogin() {
        if LoginForm.username == "" || LoginForm.password == "" {
            LoginForm.error = "Credentials required"
            return
        }
        
        let response = api.loginMock(LoginForm.username, LoginForm.password)
        if response.success {
            storage.set("auth_token", response.token)
            AppState.user = response.user
            navigate("/")
        } else {
            LoginForm.error = "Invalid credentials"
        }
    }
}
