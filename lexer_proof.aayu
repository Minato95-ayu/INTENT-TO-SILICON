app LexerPrimitivesProof

action main
    let source = "let x = 10;"
    
    # 1. char_at
    let first_char = string::char_at(source, 0)
    print("First char:")
    print(first_char)
    
    # 2. char_code (to check if it's a letter/space/etc without regex)
    let code = string::char_code(source, 0)
    print("Char code of 'l':")
    print(code)
    
    # 3. substring (to extract tokens)
    let token = string::substring(source, 0, 3)
    print("Extracted token:")
    print(token)
    
    # 4. array push/pop (to build AST or token list)
    let tokens = []
    list::push(tokens, token)
    list::push(tokens, "x")
    list::push(tokens, "=")
    
    print("Token stream:")
    print(tokens)
end

run main
