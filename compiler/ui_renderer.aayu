# ==============================================================================
# AAYU Native Self-Hosted UI Renderer (v1.2.0)
# Intent-to-Silicon Declarative UI Transpiler
# 100% Pure AAYU — Zero Python, Zero External Dependencies
# ==============================================================================

action render_props(props)
    let html = ""
    let prop_keys = map::keys(props)
    let i = 0
    let loop_len = list::length(prop_keys)
    while i < loop_len
        let k = prop_keys[i]
        let v = props[k]
        if k != "children"
            if k != "type"
                if k != "href"
                    if k == "onClick"
                        # Handle smooth anchor scrolling natively
                        if str::starts_with(v, "scroll:")
                            let target_id = str::replace(v, "scroll:", "")
                            html = html + ' onclick="document.getElementById(\'' + target_id + '\').scrollIntoView({behavior:\'smooth\'})"'
                        elif str::starts_with(v, "scroll_")
                            let target_id = str::replace(v, "scroll_", "")
                            html = html + ' onclick="document.getElementById(\'' + target_id + '\').scrollIntoView({behavior:\'smooth\'})"'
                        elif str::starts_with(v, "open_proj_")
                            html = html + ' onclick="openProjectModal(\'' + v + '\')"'
                        elif str::starts_with(v, "proj_")
                            html = html + ' onclick="openProjectModal(\'' + v + '\')"'
                        elif v == "close_modal"
                            html = html + ' onclick="closeProjectModal()"'
                        else
                            html = html + ' onclick="' + v + '"'
                        end
                    else
                        html = html + " " + k + '="' + v + '"'
                    end
                end
            end
        end
        i = i + 1
    end
    return html
end

action render_node(node)
    if typeof(node) == "str"
        return node
    end
    
    let type = node["type"]
    let props = node["props"]
    let children = node["children"]
    
    let tag = "div"
    let default_style = ""
    let extra_attrs = ""
    
    # Check if element has an href attribute to make it a clickable anchor
    let has_href = 0
    let href_val = ""
    if map::has_key(props, "href")
        has_href = 1
        href_val = props["href"]
        extra_attrs = ' href="' + href_val + '" target="_blank" rel="noopener noreferrer"'
    end
    
    if type == "Column"
        tag = "div"
        default_style = "display: flex; flex-direction: column;"
    elif type == "Row"
        tag = "div"
        default_style = "display: flex; flex-direction: row;"
    elif type == "Grid"
        tag = "div"
        default_style = "display: grid;"
    elif type == "Card"
        tag = "div"
        default_style = "display: flex;"
    elif type == "Container"
        tag = "div"
        default_style = "display: flex;"
    elif type == "button"
        if has_href == 1
            tag = "a"
        else
            tag = "button"
        end
        default_style = "cursor: pointer; border: none;"
    elif type == "Button"
        if has_href == 1
            tag = "a"
        else
            tag = "button"
        end
        default_style = "cursor: pointer; border: none;"
    elif type == "Link"
        tag = "a"
    elif type == "text"
        if has_href == 1
            tag = "a"
        else
            tag = "span"
        end
    elif type == "Text"
        if has_href == 1
            tag = "a"
        else
            tag = "span"
        end
    elif type == "heading"
        tag = "h1"
    elif type == "Heading"
        tag = "h1"
    elif type == "Icon"
        tag = "i"
        if map::has_key(props, "name")
            extra_attrs = extra_attrs + ' class="fa fa-' + props["name"] + '"'
        end
    elif type == "icon"
        tag = "i"
        if map::has_key(props, "name")
            extra_attrs = extra_attrs + ' class="fa fa-' + props["name"] + '"'
        end
    elif type == "image"
        tag = "img"
    elif type == "Image"
        tag = "img"
    elif type == "input"
        tag = "input"
    elif type == "Input"
        tag = "input"
    end
    
    # Merge default styles with custom styles if provided
    let style_attr = ""
    if default_style != ""
        style_attr = ' style="' + default_style + '"'
    end
    
    let html = "<" + tag + style_attr + extra_attrs + render_props(props) + ">"
    
    # Self-closing void tags check
    if type != "img" 
        if type != "image"
            if type != "Image"
                if type != "input"
                    if type != "Input"
                        let i = 0
                        let ch_len = list::length(children)
                        while i < ch_len
                            let child_html = render_node(children[i])
                            html = html + child_html
                            i = i + 1
                        end
                        html = html + "</" + tag + ">"
                    end
                end
            end
        end
    end
    
    return html
end

action render_page(root_node, page_title)
    let title = "AAYU Application"
    if page_title != ""
        title = page_title
    end
    
    let html = "<!DOCTYPE html>\n"
    html = html + "<html lang=\"en\">\n"
    html = html + "<head>\n"
    html = html + "    <meta charset=\"UTF-8\">\n"
    html = html + "    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n"
    html = html + "    <title>" + title + "</title>\n"
    html = html + "    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n"
    html = html + "    <style>\n"
    html = html + "        * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }\n"
    html = html + "        html, body { width: 100%; height: 100%; background-color: #0b0f19; color: #ffffff; }\n"
    html = html + "        a { text-decoration: none; color: inherit; display: inline-block; }\n"
    html = html + "        ::-webkit-scrollbar { width: 6px; }\n"
    html = html + "        ::-webkit-scrollbar-thumb { background: #374151; border-radius: 4px; }\n"
    html = html + "    </style>\n"
    html = html + "</head>\n"
    html = html + "<body>\n"
    html = html + "<div id=\"root\">\n"
    html = html + render_node(root_node)
    html = html + "\n</div>\n"
    html = html + "<script src=\"/app.js\"></script>\n"
    html = html + "</body>\n"
    html = html + "</html>"
    return html
end

