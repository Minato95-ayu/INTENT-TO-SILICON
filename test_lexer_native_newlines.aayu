# AAYU Self-Hosted Lexer (Draft 3)
# Implemented using a single tokenize function and local variables.



action is_alpha(c)
    if c >= "a"
        if c <= "z"
            return 1
        end
    end
    if c >= "A"
        if c <= "Z"
            return 1
        end
    end
    if c == "_"
        return 1
    end
    return 0
end

action is_digit(c)
    if c >= "0"
        if c <= "9"
            return 1
        end
    end
    return 0
end

action is_alphanumeric(c)
    if is_alpha(c)
        return 1
    end
    if is_digit(c)
        return 1
    end
    return 0
end

action tokenize(src)
    let tokens = []
    let pos = 0
    let line = 1
    let column = 1
    let length = len(src)
    
    let loop = 1 == 1
    while loop
        let start_line = 0
        let start_col = 0
        let value = ""
        # skip whitespace
        let ws_loop = 1 == 1
        while ws_loop
            if pos >= length
                ws_loop = 1 == 0
            else
                let c = src[pos]
                if c == " "
                    pos = pos + 1
                    column = column + 1
                else
                    if c == "\r"
                        pos = pos + 1
                    else
                        if c == "\t"
                            pos = pos + 1
                            column = column + 1
                        else
                            if c == "\n"
                                pos = pos + 1
                                line = line + 1
                                column = 1
                            else
                                ws_loop = 1 == 0
                            end
                        end
                    end
                end
            end
        end
        
        if pos >= length
tokens = tokens + [{ "type": "EOF", "value": "", "line": line, "column": column }]
            loop = 1 == 0
        else
            let c = src[pos]
            
            if is_alpha(c)
                start_line = line
                start_col = column
                value = ""
                
                let id_loop = 1 == 1
                while id_loop
                    if pos >= length
                        id_loop = 1 == 0
                    else
                        let cur = src[pos]
                        if is_alphanumeric(cur)
                            value = value + cur
                            pos = pos + 1
                            column = column + 1
                        else
                            id_loop = 1 == 0
                        end
                    end
                end
                
                let tok_type = "IDENTIFIER"
                if value == "run"
                    tok_type = "KEYWORD"
                end
                if value == "theme"
                    tok_type = "KEYWORD"
                end
                if value == "page"
                    tok_type = "KEYWORD"
                end
                if value == "state"
                    tok_type = "KEYWORD"
                end
                if value == "await"
                    tok_type = "KEYWORD"
                end
                if value == "navigate"
                    tok_type = "KEYWORD"
                end
                if value == "while"
                    tok_type = "KEYWORD"
                end
                if value == "return"
                    tok_type = "KEYWORD"
                end
                if value == "throw"
                    tok_type = "KEYWORD"
                end
                if value == "if"
                    tok_type = "KEYWORD"
                end
                if value == "try"
                    tok_type = "KEYWORD"
                end
                if value == "respond"
                    tok_type = "KEYWORD"
                end
                if value == "rethrow"
                    tok_type = "KEYWORD"
                end
                if value == "animate"
                    tok_type = "KEYWORD"
                end
                if value == "for"
                    tok_type = "KEYWORD"
                end
                if value == "task"
                    tok_type = "KEYWORD"
                end
                if value == "insert"
                    tok_type = "KEYWORD"
                end
                if value == "catch"
                    tok_type = "KEYWORD"
                end
                if value == "post"
                    tok_type = "KEYWORD"
                end
                if value == "else"
                    tok_type = "KEYWORD"
                end
                if value == "let"
                    tok_type = "KEYWORD"
                end
                if value == "print"
                    tok_type = "KEYWORD"
                end
                if value == "model"
                    tok_type = "KEYWORD"
                end
                if value == "action"
                    tok_type = "KEYWORD"
                end
                if value == "extern"
                    tok_type = "KEYWORD"
                end
                if value == "import"
                    tok_type = "KEYWORD"
                end
                if value == "app"
                    tok_type = "KEYWORD"
                end
                if value == "widget"
                    tok_type = "KEYWORD"
                end
                if value == "fn"
                    tok_type = "KEYWORD"
                end
                if value == "end"
                    tok_type = "KEYWORD"
                end
                if value == "component"
                    tok_type = "KEYWORD"
                end
                if value == "server"
                    tok_type = "KEYWORD"
                end
                if value == "elif"
                    tok_type = "KEYWORD"
                end
                if value == "useTheme"
                    tok_type = "KEYWORD"
                end
                if value == "bind"
                    tok_type = "KEYWORD"
                end
                if value == "get"
                    tok_type = "KEYWORD"
                end
                if value == "as"
                    tok_type = "KEYWORD"
                end
                if value == "in"
                    tok_type = "KEYWORD"
                end
                if value == "event"
                    tok_type = "KEYWORD"
                end
                if value == "finally"
                    tok_type = "KEYWORD"
                end
                if value == "find"
                    tok_type = "KEYWORD"
                end
                if value == "validate"
                    tok_type = "KEYWORD"
                end
                if value == "route"
                    tok_type = "KEYWORD"
                end
                
tokens = tokens + [{ "type": tok_type, "value": value, "line": start_line, "column": start_col }]
            else
                if is_digit(c)
                    start_line = line
                    start_col = column
                    value = ""
                    
                    let num_loop = 1 == 1
                    while num_loop
                        if pos >= length
                            num_loop = 1 == 0
                        else
                            let cur = src[pos]
                            if is_digit(cur)
                                value = value + cur
                                pos = pos + 1
                                column = column + 1
                            else
                                if cur == "."
                                    value = value + cur
                                    pos = pos + 1
                                    column = column + 1
                                else
                                    num_loop = 1 == 0
                                end
                            end
                        end
                    end
tokens = tokens + [{ "type": "NUMBER", "value": value, "line": start_line, "column": start_col }]
                else
                    if c == "\""
                        start_line = line
                        start_col = column
                        pos = pos + 1 # consume "
                        column = column + 1
                        
                        value = ""
                        let str_loop = 1 == 1
                        while str_loop
                            if pos >= length
                                str_loop = 1 == 0
                            else
                                let cur = src[pos]
                                if cur == "\""
                                    str_loop = 1 == 0
                                else
                                    value = value + cur
                                    pos = pos + 1
                                    column = column + 1
                                end
                            end
                        end
                        
                        if pos < length
                            pos = pos + 1 # consume "
                            column = column + 1
                        end
                        
tokens = tokens + [{ "type": "STRING", "value": value, "line": start_line, "column": start_col }]
                    else
                                                # Punctuation
                        start_line = line
                        start_col = column
                        let punct = c
                        pos = pos + 1
                        column = column + 1
                        
                        if pos < length
                            let next_c = src[pos]
                            let is_double = 1 == 0
                            
                            if c == "="
                                if next_c == "="
                                    is_double = 1 == 1
                                end
                            end
                            if c == "!"
                                if next_c == "="
                                    is_double = 1 == 1
                                end
                            end
                            if c == ">"
                                if next_c == "="
                                    is_double = 1 == 1
                                end
                            end
                            if c == "<"
                                if next_c == "="
                                    is_double = 1 == 1
                                end
                            end
                            if c == "+"
                                if next_c == "="
                                    is_double = 1 == 1
                                end
                            end
                            if c == "-"
                                if next_c == "="
                                    is_double = 1 == 1
                                end
                            end
                            if c == "&"
                                if next_c == "&"
                                    is_double = 1 == 1
                                end
                            end
                            if c == "|"
                                if next_c == "|"
                                    is_double = 1 == 1
                                end
                            end
                            if c == ":"
                                if next_c == ":"
                                    is_double = 1 == 1
                                end
                            end
                            
                            if is_double
                                punct = c + next_c
                                pos = pos + 1
                                column = column + 1
                            end
                        end
                        tokens = tokens + [{ "type": "PUNCTUATION", "value": punct, "line": start_line, "column": start_col }]
                    end
                end
            end
        end
    end
    
    return tokens
end



action main()
    let src = "let x = 10 \n let y = 20 \n print(x + y)"
    let tokens = tokenize(src)
    let length = len(tokens)
    let i = 0
    while i < length
        let t = tokens[i]
        print(t["type"])
        print(t["value"])
        i = i + 1
    end
end
main()
