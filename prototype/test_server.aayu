task home with req.
    return render "views/home.html".
end.

task submit with req.
    text name is form "username" from req.
    return "Hello " + name.
end.

task api_users with req.
    list users.
    map user.
    set "name" to "Ayush" in user.
    add user to users.
    return json users.
end.

get "/" to home.
post "/submit" to submit.
get "/api/users" to api_users.

serve on 8080.
