let component_count = 0

action create_nested_ui(depth)
    if depth == 0
        component_count = component_count + 1
        return "LeafNode"
    end
    
    let left = create_nested_ui(depth - 1)
    let right = create_nested_ui(depth - 1)
    
    component_count = component_count + 1
    return "Node"
end

print("Building massive UI Virtual DOM tree...")
let dom = create_nested_ui(12)
print("Tree built successfully. Total components generated:")
print(component_count)
